.form { background: #fff; border-radius: 16rpx; padding: 10rpx 30rpx; margin-bottom: 30rpx; }
.form-item { padding: 20rpx 0; border-bottom: 1rpx solid #f2f2f2; }
.form-item:last-child { border-bottom: none; }
.form-item.col { display: flex; flex-direction: column; }
.label { font-size: 28rpx; color: #333; font-weight: bold; margin-bottom: 12rpx; display: block; }
.picker { font-size: 28rpx; color: #666; }
.input { font-size: 28rpx; padding: 10rpx 0; }
.textarea { width: 100%; height: 260rpx; font-size: 28rpx; }
