<view class="page">
  <view class="list">
    <view class="item" wx:for="{{list}}" wx:key="id">
      <view class="cover"><cover text="{{item.name}}" seed="{{item.id}}" src="{{item.cover}}"></cover></view>
      <view class="info flex1">
        <text class="name ellipsis-1">{{item.name}}</text>
        <text class="price">¥{{item.price}} · 库存{{item.stock}} · 销量{{item.sales}}</text>
      </view>
      <view class="ops">
        <text class="op" bindtap="edit" data-id="{{item.id}}">编辑</text>
        <text class="op del" bindtap="del" data-id="{{item.id}}">删除</text>
      </view>
    </view>
    <view class="empty" wx:if="{{!list.length}}">暂无商品</view>
  </view>
  <view class="fab" bindtap="add">+</view>
</view>
