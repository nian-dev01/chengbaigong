<view class="container">
  <view class="form">
    <view class="input-box"><text class="label">账号</text><input placeholder="请输入用户名" value="{{username}}" bindinput="onInput" data-field="username"/></view>
    <view class="input-box"><text class="label">手机号</text><input placeholder="请输入注册手机号" type="number" maxlength="11" value="{{phone}}" bindinput="onInput" data-field="phone"/></view>
    <view class="input-box"><text class="label">验证码</text><input placeholder="短信验证码" value="{{code}}" bindinput="onInput" data-field="code"/><text class="code-btn" bindtap="sendCode">{{codeText}}</text></view>
    <view class="input-box"><text class="label">新密码</text><input placeholder="请输入新密码" password value="{{password}}" bindinput="onInput" data-field="password"/></view>
    <view class="btn-primary mt-30" bindtap="doReset">确认重置</view>
  </view>
</view>
