<view class="page">
  <view class="list">
    <view class="item" wx:for="{{list}}" wx:key="id">
      <image class="avatar" wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill"></image>
      <view class="avatar" wx:else>{{item.nickname[0]}}</view>
      <view class="info flex1">
        <text class="name">{{item.nickname}}</text>
        <text class="meta">{{item.username}} · {{item.phone}}</text>
        <view class="roles">
          <text class="role-tag">{{roleText(item.role)}}</text>
          <text class="status {{item.status===1?'on':'off'}}">{{item.status===1?'正常':'禁用'}}</text>
        </view>
      </view>
      <text class="toggle" bindtap="toggle" data-id="{{item.id}}">{{item.status===1?'禁用':'启用'}}</text>
    </view>
  </view>
</view>
