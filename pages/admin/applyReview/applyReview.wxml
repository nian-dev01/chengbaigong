<view class="page">
  <view class="list">
    <view class="item" wx:for="{{list}}" wx:key="id">
      <view class="top between">
        <text class="name">{{item.realName}}</text>
        <text class="status {{item.status===0?'pending':item.status===1?'pass':'reject'}}">{{statusText(item.status)}}</text>
      </view>
      <view class="meta-row"><text>身份证：</text><text>{{item.idCard}}</text></view>
      <view class="meta-row"><text>类别：</text><text>{{item.category}}</text></view>
      <view class="meta-row"><text>简介：</text><text>{{item.intro}}</text></view>
      <view class="meta-row"><text>时间：</text><text>{{item.createTime}}</text></view>
      <view class="ops" wx:if="{{item.status===0}}">
        <text class="pass" bindtap="review" data-id="{{item.id}}" data-pass="1">通过</text>
        <text class="reject" bindtap="review" data-id="{{item.id}}" data-pass="0">拒绝</text>
      </view>
    </view>
    <view class="empty" wx:if="{{!list.length}}">暂无申请</view>
  </view>
</view>
