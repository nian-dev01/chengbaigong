.page { padding: 20rpx 24rpx 140rpx; }
.item { background: #fff; border-radius: 16rpx; padding: 20rpx; margin-bottom: 20rpx; display: flex; align-items: center; }
.cover { width: 120rpx; height: 120rpx; border-radius: 12rpx; overflow: hidden; margin-right: 16rpx; }
.name { font-size: 28rpx; font-weight: bold; display: block; }
.price { font-size: 24rpx; color: #999; display: block; margin-top: 8rpx; }
.ops { display: flex; flex-direction: column; gap: 10rpx; }
.op { font-size: 24rpx; color: #2b7fff; }
.op.del { color: var(--c-primary-dark); }
.fab { position: fixed; right: 30rpx; bottom: 40rpx; width: 100rpx; height: 100rpx; border-radius: 50%; background: linear-gradient(135deg,var(--c-primary-dark),var(--c-primary)); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 60rpx; box-shadow: 0 6rpx 20rpx rgba(200,22,29,0.4); }
