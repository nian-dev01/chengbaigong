<view class="page">
  <view class="search">
    <input class="search-input" placeholder="搜索非遗文化" value="{{keyword}}" bindinput="onSearch" confirm-type="search"/>
  </view>
  <scroll-view scroll-x class="cat-bar" enhanced show-scrollbar="{{false}}">
    <view class="cat-tab {{activeCat===0?'active':''}}" bindtap="setCat" data-id="0">全部</view>
    <view class="cat-tab {{activeCat===item.id?'active':''}}" wx:for="{{categories}}" wx:key="id" bindtap="setCat" data-id="{{item.id}}">{{item.name}}</view>
  </scroll-view>
  <view class="list">
    <view class="card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="cover">
        <cover text="{{item.name}}" seed="{{item.id}}" src="{{item.cover}}"></cover>
      </view>
      <view class="info">
        <view class="top between">
          <text class="name">{{item.name}}</text>
          <text class="tag tag-red">{{item.level}}</text>
        </view>
        <text class="region">📍 {{item.region}}</text>
        <text class="intro ellipsis-2">{{item.intro}}</text>
        <view class="bottom between">
          <text class="meta">👁 {{item.views}} · ❤️ {{item.likes}}</text>
        </view>
      </view>
    </view>
    <view class="empty" wx:if="{{!list.length}}">暂无相关非遗</view>
  </view>
</view>
