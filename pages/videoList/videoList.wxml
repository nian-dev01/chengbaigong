<view class="page">
  <view class="search">
    <input class="search-input" placeholder="搜索非遗视频" value="{{keyword}}" bindinput="onSearch"/>
  </view>
  <scroll-view scroll-x class="cat-bar" enhanced show-scrollbar="{{false}}">
    <view class="cat-tab {{activeType===0?'active':''}}" bindtap="setType" data-id="0">全部</view>
    <view class="cat-tab {{activeType===item.id?'active':''}}" wx:for="{{types}}" wx:key="id" bindtap="setType" data-id="{{item.id}}">{{item.name}}</view>
  </scroll-view>
  <view class="list">
    <view class="card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="cover">
        <cover text="{{item.title}}" seed="{{item.id}}" src="{{item.cover}}"></cover>
        <text class="duration">{{item.duration}}</text>
      </view>
      <view class="info">
        <text class="title ellipsis-1">{{item.title}}</text>
        <text class="intro ellipsis-2">{{item.intro}}</text>
        <text class="meta">👁 {{item.views}} 次播放</text>
      </view>
    </view>
    <view class="empty" wx:if="{{!list.length}}">暂无视频</view>
  </view>
</view>
