<view class="page">
  <view class="list">
    <view class="order" wx:for="{{list}}" wx:key="id">
      <view class="o-head between">
        <text class="no">{{item.orderNo}}</text>
        <text class="status">{{statusText(item.status)}}</text>
      </view>
      <view class="goods">
        <text class="g" wx:for="{{item.items}}" wx:for-item="g" wx:key="productId">{{g.name}} x{{g.count}}</text>
      </view>
      <view class="o-foot between">
        <text class="total">合计：¥{{item.total}}</text>
        <view class="ops">
          <text class="ship" wx:if="{{item.status==='paid'}}" bindtap="ship" data-id="{{item.id}}">发货</text>
        </view>
      </view>
    </view>
    <view class="empty" wx:if="{{!list.length}}">暂无订单</view>
  </view>
</view>
