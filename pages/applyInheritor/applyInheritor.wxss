.page { background: var(--grad-bg); }
.tip { background: #fff3e0; color: #ff8c1a; font-size: 26rpx; line-height: 1.6; }
.form { background: #fff; border-radius: 16rpx; padding: 10rpx 30rpx; margin: 20rpx 0; }
.form-item { display: flex; align-items: center; min-height: 100rpx; border-bottom: 1rpx solid #f2f2f2; }
.form-item:last-child { border-bottom: none; }
.form-item.col { flex-direction: column; align-items: flex-start; padding: 20rpx 0; }
.label { font-size: 28rpx; color: #333; width: 150rpx; }
.form-item.col .label { width: auto; margin-bottom: 12rpx; font-weight: bold; }
.val { flex: 1; height: 100rpx; font-size: 28rpx; text-align: right; }
.textarea { width: 100%; height: 180rpx; font-size: 28rpx; }
.upload { width: 100%; height: 160rpx; background: #f5f5f5; border-radius: 12rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #999; font-size: 26rpx; }
.up-icon { font-size: 50rpx; margin-bottom: 10rpx; }
.file-name { font-size: 24rpx; color: var(--c-primary-dark); margin-top: 10rpx; }
