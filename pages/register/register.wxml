<view class="container">
  <view class="form">
    <view class="input-box"><text class="label">用户名</text><input placeholder="请输入用户名" value="{{username}}" bindinput="onInput" data-field="username"/></view>
    <view class="input-box"><text class="label">手机号</text><input placeholder="请输入手机号" type="number" maxlength="11" value="{{phone}}" bindinput="onInput" data-field="phone"/></view>
    <view class="input-box"><text class="label">密码</text><input placeholder="请输入密码" password value="{{password}}" bindinput="onInput" data-field="password"/></view>
    <view class="input-box"><text class="label">确认</text><input placeholder="请再次输入密码" password value="{{password2}}" bindinput="onInput" data-field="password2"/></view>
    <view class="btn-primary mt-30" bindtap="doRegister">注 册</view>
    <view class="text-center mt-20"><text class="link" bindtap="goLogin">已有账号？去登录</text></view>
  </view>
</view>
