.login-page {
  min-height: 100vh;
  background: var(--grad-bg);
  padding: 60rpx 48rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}
.login-page::before {
  content: '';
  position: absolute;
  width: 400rpx; height: 400rpx;
  background: radial-gradient(circle, rgba(184,220,207,0.5) 0%, transparent 70%);
  top: -150rpx; right: -120rpx;
  border-radius: 50%;
  pointer-events: none;
}
.login-page::after {
  content: '';
  position: absolute;
  width: 300rpx; height: 300rpx;
  background: radial-gradient(circle, rgba(240,207,193,0.35) 0%, transparent 70%);
  bottom: -80rpx; left: -60rpx;
  border-radius: 50%;
  pointer-events: none;
}

.logo { text-align: center; margin-bottom: 60rpx; position: relative; z-index: 1; }
.app-name {
  font-size: 72rpx; /* 小初 ≈ 36pt */
  font-family: "FZShuTi", "方正舒体", "STXingkai", "KaiTi", serif;
  font-weight: normal;
  letter-spacing: 4rpx;
  line-height: 1.2;
  color: var(--c-primary-dark);
  display: block;
}
.slogan { font-size: 24rpx; color: var(--c-text-soft); margin-top: 10rpx; display: block; }

.form {
  background: var(--c-card);
  border-radius: 24rpx 16rpx 24rpx 16rpx;
  padding: 40rpx 30rpx;
  box-shadow: var(--shadow-card);
  position: relative; z-index: 1;
}
.input-box {
  background: var(--c-fresh);
  border: 1rpx solid var(--c-moss);
  border-radius: 16rpx 10rpx 16rpx 10rpx;
  padding: 0 20rpx;
  height: 90rpx;
  display: flex; align-items: center;
  margin-bottom: 24rpx;
  transition: border-color 0.2s ease, background 0.2s ease;
}
.input-box:focus-within {
  border-color: var(--c-primary);
  background: #fff;
}
.input-box .label { font-size: 28rpx; color: var(--c-text-soft); width: 100rpx; }
.input-box input { flex: 1; height: 90rpx; font-size: 28rpx; color: var(--c-text); }

.btn-wechat {
  margin-top: 24rpx;
  height: 88rpx;
  border-radius: 16rpx 10rpx 16rpx 10rpx;
  background: #07C160;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  box-shadow: 0 6rpx 18rpx rgba(7, 193, 96, 0.25);
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.btn-wechat:active { transform: scale(0.97); opacity: 0.9; }
.wx-ico {
  width: 44rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 50%;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.links { display: flex; justify-content: space-between; margin-top: 10rpx; }
.links .link { font-size: 26rpx; color: var(--c-primary-dark); }

