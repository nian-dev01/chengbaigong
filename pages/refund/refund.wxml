<view class="container">
  <view class="card">
    <view class="section-title" style="margin-top:0">退款原因</view>
    <view class="reason-list">
      <view class="reason {{reason===item?'active':''}}" wx:for="{{reasons}}" wx:key="*this" bindtap="selectReason" data-v="{{item}}">{{item}}</view>
    </view>
    <view class="section-title">补充说明</view>
    <textarea class="desc" placeholder="请详细描述退款原因..." value="{{desc}}" bindinput="onDesc" maxlength="200"/>
  </view>
  <view class="btn-primary" bindtap="submit">提交退款申请</view>
</view>
