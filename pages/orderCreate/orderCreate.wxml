<view class="page">
  <!-- 收货地址卡片 -->
  <view class="addr-card tap-scale" bindtap="chooseAddress">
    <view wx:if="{{address}}">
      <view class="addr-top">
        <text class="addr-name">{{address.name}}</text>
        <text class="addr-phone">{{address.phone}}</text>
        <view class="default-tag" wx:if="{{address.isDefault}}">默认</view>
      </view>
      <view class="addr-detail">
        <text class="addr-region">{{address.province}}{{address.city}}{{address.district}}</text>
        <text class="addr-detail-text">{{address.detail}}</text>
      </view>
    </view>
    <view wx:else class="empty-addr">
      <text class="empty-addr-icon">📍</text>
      <text class="empty-addr-text">请选择收货地址</text>
    </view>
    <view class="addr-arrow">›</view>
    <view class="addr-deco"></view>
  </view>

  <!-- 商品卡片 -->
  <view class="goods-card">
    <view class="card-header">
      <text class="card-title">非遗文创商品</text>
    </view>
    <view class="goods-item" wx:for="{{items}}" wx:key="productId">
      <view class="g-cover">
        <cover text="{{item.name}}" seed="{{item.productId}}" src="{{item.cover}}"></cover>
      </view>
      <view class="g-info flex1">
        <text class="g-name ellipsis-2">{{item.name}}</text>
        <view class="g-bottom">
          <text class="g-price">¥{{item.price}}</text>
          <text class="g-count">x{{item.count}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 金额明细 -->
  <view class="amount-card">
    <view class="amount-row">
      <text class="amount-label">商品金额</text>
      <text class="amount-value">¥{{goodsTotal}}</text>
    </view>
    <view class="amount-row">
      <text class="amount-label">运费</text>
      <text class="amount-free">免运费</text>
    </view>
    <view class="divider-line"></view>
    <view class="amount-row total-row">
      <text class="amount-label">实付金额</text>
      <text class="amount-total">¥{{goodsTotal}}</text>
    </view>
  </view>

  <!-- 底部提交栏 -->
  <view class="bottom-bar submit-bar">
    <view class="submit-info">
      <text class="submit-label">实付：</text>
      <text class="submit-total">¥{{goodsTotal}}</text>
    </view>
    <view class="btn-primary submit-btn tap-scale" bindtap="submitOrder">提交订单</view>
  </view>
</view>
