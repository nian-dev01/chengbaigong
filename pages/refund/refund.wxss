.page { background: var(--grad-bg); }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 30rpx; }
.reason-list { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 30rpx; }
.reason { padding: 20rpx; background: #f5f5f5; border-radius: 12rpx; font-size: 28rpx; color: #666; }
.reason.active { background: #fdecec; color: var(--c-primary-dark); border: 2rpx solid var(--c-primary-dark); }
.desc { width: 100%; height: 200rpx; background: #f5f5f5; border-radius: 12rpx; padding: 20rpx; box-sizing: border-box; font-size: 26rpx; }
