.page { padding: 20rpx 24rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.icon { width: 80rpx; height: 80rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; font-size: 40rpx; margin-right: 20rpx; }
.icon.blue { background: #e8f3ff; }
.icon.orange { background: #fff3e0; }
.name { font-size: 30rpx; font-weight: bold; display: block; }
.sub { font-size: 24rpx; color: #999; display: block; margin-top: 4rpx; }
.arrow { color: #ccc; font-size: 36rpx; }
