.page { padding: 20rpx 24rpx 40rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.metric-grid { display: flex; flex-wrap: wrap; }
.metric { width: 25%; text-align: center; padding: 16rpx 0; }
.metric .num { font-size: 34rpx; font-weight: bold; color: var(--c-primary-dark); display: block; }
.metric .lbl { font-size: 22rpx; color: #999; display: block; margin-top: 6rpx; }

.chart { margin-top: 10rpx; }
.bar-row { display: flex; align-items: center; margin-bottom: 16rpx; }
.bar-name { width: 130rpx; font-size: 24rpx; color: #666; }
.bar-track { flex: 1; height: 30rpx; background: #f5f5f5; border-radius: 15rpx; overflow: hidden; margin: 0 16rpx; }
.bar-fill { height: 100%; background: linear-gradient(90deg,var(--c-primary-dark),var(--c-primary)); border-radius: 15rpx; transition: width 0.6s; }
.bar-val { width: 50rpx; font-size: 24rpx; color: #333; text-align: right; }

.overview { display: flex; flex-wrap: wrap; }
.ov-item { width: 50%; padding: 14rpx 0; font-size: 26rpx; color: #555; display: flex; align-items: center; }
.ov-icon { margin-right: 10rpx; }

.pie-row { display: flex; height: 40rpx; border-radius: 20rpx; overflow: hidden; margin-top: 20rpx; }
.pie-seg { display: flex; align-items: center; justify-content: center; font-size: 20rpx; color: #fff; }
.seg { width: 100%; height: 40rpx; }
.seg.user { background: #2b7fff; }
.seg.inh { background: var(--c-gold); }
.seg.admin { background: #999; }
.pie-seg text { position: absolute; }
