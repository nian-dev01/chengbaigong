.page { padding-bottom: 40rpx; }
.header { background: linear-gradient(135deg,var(--c-primary-dark),var(--c-primary)); padding: 40rpx 30rpx 30rpx; color: #fff; }
.avatar { width: 100rpx; height: 100rpx; border-radius: 50%; background: rgba(255,255,255,0.3); display: flex; align-items: center; justify-content: center; font-size: 44rpx; font-weight: bold; margin-right: 20rpx; }
.name { font-size: 34rpx; font-weight: bold; display: block; }
.role { font-size: 24rpx; opacity: 0.85; display: block; margin-top: 4rpx; }
.stats { display: flex; margin-top: 30rpx; background: rgba(255,255,255,0.15); border-radius: 16rpx; padding: 20rpx 0; }
.stat { flex: 1; text-align: center; }
.stat .num { display: block; font-size: 34rpx; font-weight: bold; }
.stat .lbl { font-size: 22rpx; opacity: 0.85; }

.grid { display: flex; flex-wrap: wrap; margin: 20rpx 24rpx; background: #fff; border-radius: 16rpx; padding: 10rpx 0; }
.g-item { width: 33.33%; display: flex; flex-direction: column; align-items: center; padding: 30rpx 0; }
.g-icon { font-size: 50rpx; margin-bottom: 10rpx; }
.g-item text:last-child { font-size: 24rpx; color: #666; }

.card { margin: 20rpx 24rpx; }
.back { color: var(--c-primary-dark); font-size: 28rpx; }
