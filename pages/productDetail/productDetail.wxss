.page {
  padding-bottom: 130rpx;
  background: var(--grad-bg);
  min-height: 100vh;
}
.cover {
  height: 600rpx;
  box-shadow: var(--shadow-card);
}

.card-section {
  background: var(--c-card);
  border-radius: 24rpx 16rpx 24rpx 16rpx;
  margin: 20rpx 24rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-card);
}

.section {
  margin: 20rpx 24rpx;
}
.price-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}
.price {
  font-size: 48rpx;
  color: var(--c-primary-dark);
  font-weight: bold;
}
.origin {
  font-size: 26rpx;
  color: var(--c-text-light);
  text-decoration: line-through;
}
.sales {
  font-size: 24rpx;
  color: var(--c-text-light);
  margin-left: auto;
}
.title {
  font-size: 34rpx;
  font-weight: bold;
  margin-top: 12rpx;
  color: var(--c-text);
}
.tags {
  margin-top: 12rpx;
}

.shop-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  transition: transform 0.15s ease;
}
.shop-row:active {
  transform: scale(0.98);
}
.s-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx 10rpx 16rpx 10rpx;
  background: var(--grad-primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 16rpx;
}
.s-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: var(--c-text);
}
.s-region {
  font-size: 22rpx;
  color: var(--c-text-light);
}
.arrow {
  color: var(--c-primary-dark);
  font-size: 24rpx;
}
.intro {
  font-size: 28rpx;
  color: var(--c-text);
  line-height: 1.8;
}
.stock {
  font-size: 24rpx;
  color: var(--c-text-light);
  margin-top: 12rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.98);
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  border-top: 1rpx solid var(--c-moss);
  gap: 12rpx;
  z-index: 10;
}
.action {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 20rpx;
  color: var(--c-text-soft);
}
.a-icon {
  font-size: 36rpx;
}
.btn-cart,
.btn-buy {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  transition: all 0.2s ease;
}
.btn-cart {
  background: var(--grad-warm);
  color: #fff;
  box-shadow: 0 4rpx 20rpx rgba(240, 207, 193, 0.3);
}
.btn-buy {
  background: var(--grad-primary);
  color: #fff;
  box-shadow: var(--shadow-soft);
}
