/* cart.wxss - 柔性自然系 v3 */
.page {
  padding: 24rpx 28rpx 180rpx;
  background: var(--grad-bg);
  min-height: 100vh;
}

/* === 页面头部 === */
.page-header {
  padding: 16rpx 0 28rpx;
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--c-text);
}
.header-count {
  font-size: 24rpx;
  color: var(--c-text-light);
}

/* === 购物车卡片 === */
.cart-card {
  background: #fff;
  border-radius: 24rpx 16rpx 24rpx 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  position: relative;
}

/* === 勾选框 === */
.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid var(--c-moss);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 6rpx;
  transition: all 0.25s ease;
}
.checkbox.on {
  background: var(--grad-primary);
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(145, 203, 184, 0.35);
}
.checkbox.small {
  width: 36rpx;
  height: 36rpx;
  margin-top: 0;
}
.check-icon {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

/* === 商品图 === */
.c-cover {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
}

/* === 商品信息 === */
.c-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.c-name {
  font-size: 28rpx;
  color: var(--c-text);
  line-height: 1.5;
}
.c-bottom-row {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
}
.c-price {
  font-size: 32rpx;
  color: var(--c-primary-dark);
  font-weight: bold;
}

/* === 数量步进器 === */
.stepper {
  display: flex;
  align-items: center;
  gap: 0;
  background: var(--c-fresh);
  border-radius: 32rpx;
  padding: 4rpx;
}
.step-btn {
  width: 52rpx;
  height: 48rpx;
  text-align: center;
  line-height: 44rpx;
  font-size: 30rpx;
  color: var(--c-primary-dark);
  border-radius: 50%;
  transition: all 0.15s;
}
.step-plus {
  background: var(--grad-primary);
  color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(145, 203, 184, 0.3);
}
.count {
  width: 64rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--c-text);
}

/* === 删除按钮 === */
.del-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 52rpx;
  height: 52rpx;
  background: rgba(240, 207, 193, 0.15);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

/* === 空购物车 === */
.empty-wrap {
  padding: 160rpx 60rpx;
  text-align: center;
}
.empty-illustration {
  font-size: 140rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}
.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--c-text);
}
.empty-sub {
  display: block;
  font-size: 26rpx;
  color: var(--c-text-light);
  margin-top: 12rpx;
}
.go-shop-btn {
  margin-top: 48rpx;
  display: inline-block;
  padding: 0 80rpx;
}

/* === 底部结算栏 === */
.cart-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.select-all {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.select-all-text {
  font-size: 26rpx;
  color: var(--c-text);
}
.total-info {
  flex: 1;
  text-align: right;
}
.total-label {
  font-size: 24rpx;
  color: var(--c-text-soft);
}
.total-price {
  font-size: 36rpx;
  color: var(--c-primary-dark);
  font-weight: bold;
}
.pay-btn {
  padding: 0 44rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pay-count {
  font-size: 24rpx;
  margin-left: 4rpx;
  opacity: 0.9;
}
