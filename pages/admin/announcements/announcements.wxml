<view class="page">
  <view class="list">
    <view class="item" wx:for="{{list}}" wx:key="id">
      <view class="top between">
        <text class="title ellipsis-1">{{item.title}}</text>
        <text class="tag {{item.type==='activity'?'tag-orange':'tag-blue'}}">{{item.type==='activity'?'活动':'系统'}}</text>
      </view>
      <text class="content ellipsis-1">{{item.content}}</text>
      <text class="time">{{item.createTime}}</text>
      <view class="ops">
        <text class="op" bindtap="edit" data-item="{{item}}">编辑</text>
        <text class="op del" bindtap="del" data-id="{{item.id}}">删除</text>
      </view>
    </view>
    <view class="empty" wx:if="{{!list.length}}">暂无公告</view>
  </view>
  <view class="fab" bindtap="add">+</view>

  <view class="mask" wx:if="{{showModal}}" bindtap="closeModal">
    <view class="modal" catchtap="">
      <view class="modal-title">{{form.id?'编辑':'新增'}}公告</view>
      <view class="m-item"><text class="m-label">标题</text><input class="m-val" value="{{form.title}}" bindinput="onInput" data-field="title"/></view>
      <view class="m-item"><text class="m-label">类型</text>
        <picker mode="selector" range="{{['系统','活动']}}" value="{{typeIdx}}" bindchange="onType">
          <view class="picker">{{form.type==='activity'?'活动':'系统'}} ▾</view>
        </picker>
      </view>
      <view class="m-item col"><text class="m-label">内容</text><textarea class="m-ta" style="height:180rpx" value="{{form.content}}" bindinput="onInput" data-field="content"/></view>
      <view class="row" style="gap:20rpx">
        <view class="btn-outline flex1" bindtap="closeModal">取消</view>
        <view class="btn-primary flex1" bindtap="save">保存</view>
      </view>
    </view>
  </view>
</view>
