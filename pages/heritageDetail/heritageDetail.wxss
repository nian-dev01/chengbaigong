.page {
  padding-bottom: 140rpx;
  background: var(--grad-bg);
  min-height: 100vh;
}
.cover {
  height: 420rpx;
  position: relative;
  box-shadow: var(--shadow-card);
}
.cover-meta {
  position: absolute;
  bottom: 20rpx;
  left: 24rpx;
}
.region {
  color: #fff;
  font-size: 24rpx;
  margin-left: 10rpx;
  text-shadow: 0 2rpx 8rpx rgba(83, 111, 101, 0.5);
}
.section {
  margin: 20rpx 24rpx;
}
.title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--c-text);
}
.meta-row {
  display: flex;
  gap: 30rpx;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--c-text-light);
}
.divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--c-moss), transparent);
  margin: 20rpx 0;
}
.content {
  font-size: 28rpx;
  color: var(--c-text);
  line-height: 1.8;
  margin-bottom: 16rpx;
}

.inh-card {
  background: var(--c-card);
  border-radius: 24rpx 16rpx 24rpx 16rpx;
  padding: 24rpx;
  margin: 20rpx 24rpx;
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: center;
  transition: transform 0.15s ease;
}
.inh-card:active {
  transform: scale(0.98);
}
.inh-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--grad-primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
  margin-right: 20rpx;
}
.inh-name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: var(--c-text);
}
.inh-title {
  font-size: 24rpx;
  color: var(--c-text-light);
}
.arrow {
  color: var(--c-text-light);
  font-size: 40rpx;
  margin-left: auto;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.98);
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  border-top: 1rpx solid var(--c-moss);
  z-index: 10;
}
.action {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 24rpx;
  font-size: 22rpx;
  color: var(--c-text-soft);
}
.a-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}
.btn-bottom {
  flex: 1;
  margin-left: 20rpx;
}
