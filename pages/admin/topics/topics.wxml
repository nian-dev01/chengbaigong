<view class="page">
  <view class="list">
    <view class="item" wx:for="{{list}}" wx:key="id">
      <view class="top between">
        <text class="name ellipsis-1">{{item.title}}</text>
        <text class="tag {{item.status===1?'tag-green':'tag-gray'}}">{{item.status===1?'已通过':'待审核'}}</text>
      </view>
      <text class="content ellipsis-2">{{item.content}}</text>
      <view class="meta-row">
        <text>{{item.userName}}</text>
        <text>{{item.createTime}}</text>
        <text>❤️ {{item.likes}} 💬 {{item.comments}}</text>
      </view>
      <view class="ops" wx:if="{{item.status!==1}}">
        <text class="pass" bindtap="review" data-id="{{item.id}}" data-pass="1">通过</text>
        <text class="reject" bindtap="review" data-id="{{item.id}}" data-pass="0">拒绝</text>
      </view>
    </view>
    <view class="empty" wx:if="{{!list.length}}">暂无话题</view>
  </view>
</view>
