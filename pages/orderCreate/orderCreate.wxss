/* orderCreate.wxss - 柔性自然系 v3 */
.page {
  padding: 24rpx 28rpx 180rpx;
  background: var(--grad-bg);
  min-height: 100vh;
}

/* === 收货地址卡片 === */
.addr-card {
  background: linear-gradient(135deg, #fff 0%, #F2FAF6 100%);
  border-radius: 28rpx 16rpx 28rpx 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
  position: relative;
  overflow: hidden;
}
.addr-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 8rpx;
  height: 100%;
  background: var(--grad-primary);
}
.addr-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.addr-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--c-text);
}
.addr-phone {
  font-size: 28rpx;
  color: var(--c-text-soft);
}
.default-tag {
  background: var(--grad-primary);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}
.addr-detail {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.addr-region {
  font-size: 26rpx;
  color: var(--c-primary-dark);
  font-weight: 500;
}
.addr-detail-text {
  font-size: 26rpx;
  color: var(--c-text-soft);
  line-height: 1.6;
}
.addr-arrow {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 52rpx;
  height: 52rpx;
  background: var(--c-fresh);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--c-primary);
  font-size: 36rpx;
  font-weight: bold;
}
.addr-deco {
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  background: rgba(145, 203, 184, 0.08);
  border-radius: 50%;
  bottom: -40rpx;
  right: -40rpx;
}

/* 空地址态 */
.empty-addr {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 8rpx 0;
}
.empty-addr-icon {
  font-size: 40rpx;
}
.empty-addr-text {
  font-size: 28rpx;
  color: var(--c-text-light);
}

/* === 商品卡片 === */
.goods-card {
  background: #fff;
  border-radius: 20rpx 16rpx 20rpx 16rpx;
  padding: 0 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
  overflow: hidden;
}
.card-header {
  padding: 24rpx 0;
  border-bottom: 1rpx dashed var(--c-moss);
}
.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--c-text);
}
.goods-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  gap: 20rpx;
  border-top: 1rpx dashed var(--c-fresh);
}
.goods-item:first-of-type {
  border-top: none;
}
.g-cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.g-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.g-name {
  font-size: 26rpx;
  color: var(--c-text);
  line-height: 1.5;
}
.g-bottom {
  margin-top: auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12rpx;
}
.g-price {
  font-size: 30rpx;
  color: var(--c-primary-dark);
  font-weight: bold;
}
.g-count {
  font-size: 26rpx;
  color: var(--c-text-light);
}

/* === 金额明细 === */
.amount-card {
  background: #fff;
  border-radius: 16rpx 24rpx 16rpx 24rpx;
  padding: 24rpx 28rpx;
  box-shadow: var(--shadow-card);
}
.amount-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}
.amount-label {
  font-size: 26rpx;
  color: var(--c-text-soft);
}
.amount-value {
  font-size: 26rpx;
  color: var(--c-text);
}
.amount-free {
  font-size: 26rpx;
  color: var(--c-primary);
  font-weight: 500;
}
.divider-line {
  height: 1rpx;
  background: var(--c-moss);
  margin: 12rpx 0;
}
.total-row {
  padding-top: 16rpx;
}
.total-row .amount-label {
  font-size: 28rpx;
  color: var(--c-text);
  font-weight: 500;
}
.amount-total {
  font-size: 38rpx;
  color: var(--c-primary-dark);
  font-weight: bold;
}

/* === 底部提交栏 === */
.submit-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.submit-info {
  flex: 1;
}
.submit-label {
  font-size: 26rpx;
  color: var(--c-text-soft);
}
.submit-total {
  font-size: 40rpx;
  color: var(--c-primary-dark);
  font-weight: bold;
}
.submit-btn {
  padding: 0 60rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
}
