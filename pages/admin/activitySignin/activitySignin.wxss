.page { padding: 20rpx 24rpx; }
.sel { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.picker-box { font-size: 28rpx; color: #333; }
.item { background: #fff; border-radius: 16rpx; padding: 20rpx; margin-bottom: 16rpx; display: flex; align-items: center; }
.avatar { width: 60rpx; height: 60rpx; border-radius: 50%; background: linear-gradient(135deg,var(--c-primary-dark),var(--c-primary)); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: bold; margin-right: 16rpx; }
.name { font-size: 28rpx; font-weight: bold; display: block; }
.meta { font-size: 22rpx; color: #999; display: block; margin-top: 4rpx; }
.status-box { text-align: right; }
.code { font-size: 22rpx; color: #999; display: block; margin-top: 6rpx; }
