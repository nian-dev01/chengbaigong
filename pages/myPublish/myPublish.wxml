<view class="page">
  <view class="list">
    <view class="card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="top between">
        <text class="title ellipsis-1">{{item.title}}</text>
        <text class="time">{{item.createTime}}</text>
      </view>
      <text class="content ellipsis-2">{{item.content}}</text>
      <view class="bottom between">
        <view class="meta">
          <text>💬 {{item.comments}}</text>
          <text>❤️ {{item.likes}}</text>
          <text>👁 {{item.views}}</text>
        </view>
        <view class="ops">
          <text class="tag" wx:if="{{item.isRecommend}}">推荐</text>
          <text class="del" catchtap="delTopic" data-id="{{item.id}}">删除</text>
        </view>
      </view>
    </view>
    <view class="empty" wx:if="{{!list.length}}">还没有发布过话题</view>
  </view>
</view>
