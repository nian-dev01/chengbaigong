.form { background: #fff; border-radius: 16rpx; padding: 10rpx 30rpx; }
.form-item { display: flex; align-items: center; height: 100rpx; border-bottom: 1rpx solid #f2f2f2; }
.form-item:last-child { border-bottom: none; }
.label { font-size: 28rpx; color: #333; width: 150rpx; }
.val { flex: 1; height: 100rpx; font-size: 28rpx; text-align: right; }
