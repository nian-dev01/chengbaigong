<view class="page">
  <view class="card">
    <view class="title">活动签到</view>
    <text class="tip">请输入您的签到码（可在活动详情页查看）</text>
    <input class="code-input" placeholder="请输入签到码" value="{{code}}" bindinput="onInput"/>
    <view class="btn-primary mt-30" bindtap="doSignin">确认签到</view>
  </view>
  <view class="card result" wx:if="{{result}}">
    <text class="result-icon">✅</text>
    <text class="result-text">签到成功！欢迎参加活动</text>
  </view>
</view>
