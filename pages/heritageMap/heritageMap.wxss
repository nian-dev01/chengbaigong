.page {background: var(--grad-bg);
min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 标题区 */
.title-bar {
  text-align: center;
  padding: 36rpx 0 96rpx;
  position: relative;
  background: linear-gradient(180deg, #f8f3e7 0%, rgba(248, 243, 231, 0) 100%);
}

.title-cn {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--c-text);
  letter-spacing: 12rpx;
}

.title-sub {
  font-size: 22rpx;
  color: var(--c-text-light);
  margin-top: 8rpx;
  letter-spacing: 6rpx;
}

.seal {
  position: absolute;
  top: 26rpx;
  right: 40rpx;
  width: 64rpx;
  height: 64rpx;
  background: rgba(62, 95, 85, 0.08);
  color: var(--c-text);
  font-size: 20rpx;
  font-weight: bold;
  border: 1rpx solid rgba(62, 95, 85, 0.18);
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-6deg);
  box-shadow: 0 2rpx 8rpx rgba(62, 95, 85, 0.08);
}

/* 地图 */
.map-wrap {
  position: relative;
  margin: -48rpx 30rpx 20rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(61, 81, 72, 0.08);
  border: 1rpx solid rgba(62, 95, 85, 0.08);
}

.china-map {
  width: 100%;
  display: block;
  border-radius: 8rpx;
}

/* 省份热区 */
.hotspot {
  position: absolute;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
}

.dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  border: 3rpx solid #fff;
  box-shadow: 0 0 0 2rpx var(--c-primary-dark);
}

.dot-active {
  background: var(--c-primary-dark);
  box-shadow:
    0 0 0 2rpx var(--c-primary-dark),
    0 0 10rpx rgba(200, 22, 29, 0.5);
  animation: pulse 2s infinite;
}

.dot-empty {
  background: #999;
  box-shadow: 0 0 0 2rpx #aaa;
}

@keyframes pulse {
  0%,
  100% {
    box-shadow:
      0 0 0 2rpx var(--c-primary-dark),
      0 0 10rpx rgba(200, 22, 29, 0.5);
  }
  50% {
    box-shadow:
      0 0 0 2rpx var(--c-primary-dark),
      0 0 20rpx rgba(200, 22, 29, 0.8);
  }
}

.spot-label {
  font-size: 18rpx;
  color: var(--c-text);
  margin-top: 4rpx;
  background: rgba(255, 255, 255, 0.9);
  padding: 1rpx 6rpx;
  border-radius: 4rpx;
}

.spot-count {
  position: absolute;
  top: -12rpx;
  left: 16rpx;
  min-width: 28rpx;
  height: 28rpx;
  background: var(--c-primary-dark);
  color: #fff;
  font-size: 18rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
  border: 2rpx solid #fff;
}

/* 统计栏 */
.stats-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  margin: 0 30rpx 30rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(42, 58, 74, 0.06);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--c-primary-dark);
}

.stat-lbl {
  font-size: 22rpx;
  color: #666;
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #eee;
}

/* 省份网格 */
.province-section {
  padding: 0 30rpx;
}

.p-section-title {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding-left: 12rpx;
  border-left: 6rpx solid var(--c-primary-dark);
}

.p-title-cn {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--c-text);
}

.p-title-en {
  font-size: 18rpx;
  color: #aaa;
  letter-spacing: 2rpx;
}

.province-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.province-tile {
  width: calc((100% - 48rpx) / 4);
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 10rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(42, 58, 74, 0.05);
  border: 1rpx solid rgba(212, 168, 67, 0.1);
  transition: all 0.2s;
}

.province-tile:active {
  background: #fdecec;
  transform: scale(0.97);
}

.tile-name {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--c-text);
  display: block;
}

.tile-count {
  font-size: 20rpx;
  color: var(--c-primary-dark);
  margin-top: 4rpx;
  display: block;
}

.footer-note {
  text-align: center;
  font-size: 20rpx;
  color: #bbb;
  margin-top: 40rpx;
}

/* 弹窗 */
.prov-popup {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 99;
  display: flex;
  align-items: flex-end;
}

.pop-card {
  width: 100%;
  max-height: 70vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}

.pop-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.pop-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--c-text);
}

.pop-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.pop-list {
  flex: 1;
  padding: 20rpx;
  max-height: 60vh;
}

.pop-item {
  display: flex;
  gap: 20rpx;
  padding: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.pop-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.pop-info {
  min-width: 0;
}

.pop-name {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--c-text);
  display: block;
}

.pop-tags {
  margin: 8rpx 0;
}

.pop-level {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
}

.tag-gold {
  background: #fdf6e3;
  color: #b8860b;
}
.tag-red {
  background: #fdecec;
  color: var(--c-primary-dark);
}

.pop-intro {
  font-size: 24rpx;
  color: #666;
  display: block;
}
