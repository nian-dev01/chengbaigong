/* addressEdit.wxss - 柔性自然系 v3 */
.container {
  padding: 24rpx 28rpx;
  background: var(--grad-bg);
  min-height: 100vh;
}
.form-card {
  background: #fff;
  border-radius: 20rpx 16rpx 20rpx 16rpx;
  padding: 10rpx 30rpx;
  box-shadow: var(--shadow-card);
}
.form-item {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 1rpx dashed var(--c-moss);
}
.form-item-last {
  border-bottom: none;
}
.label {
  font-size: 28rpx;
  color: var(--c-text);
  width: 160rpx;
  flex-shrink: 0;
}
.val {
  flex: 1;
  height: 100rpx;
  font-size: 28rpx;
  text-align: right;
  color: var(--c-text);
}

.switch-card {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 16rpx 20rpx 16rpx 20rpx;
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: var(--shadow-card);
}

.save-btn {
  margin-top: 60rpx;
  height: 92rpx;
  font-size: 30rpx;
  letter-spacing: 4rpx;
}
