.page {
  padding-bottom: 40rpx;
  background: var(--grad-bg);
  min-height: 100vh;
}

.header {
  background: var(--grad-primary);
  padding: 50rpx 30rpx 30rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
}
.header::before {
  content: "";
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(
    circle,
    rgba(255, 255, 255, 0.35) 0%,
    transparent 70%
  );
  top: -100rpx;
  right: -80rpx;
  border-radius: 50%;
}
.header::after {
  content: "";
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(
    circle,
    rgba(240, 207, 193, 0.4) 0%,
    transparent 70%
  );
  bottom: -50rpx;
  left: -40rpx;
  border-radius: 50%;
}

.user-info {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}
.user-info .avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: bold;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}
.info {
  margin-left: 24rpx;
}
.nickname {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
}
.role-tags {
  margin-top: 10rpx;
}
.role-tag {
  display: inline-block;
  background: rgba(255, 255, 255, 0.25);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-right: 10rpx;
}
.role-inh {
  background: rgba(240, 207, 193, 0.5);
}
.role-admin {
  background: rgba(199, 228, 236, 0.5);
}
.edit {
  font-size: 26rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}

.stats {
  position: relative;
  z-index: 1;
  margin-top: 30rpx;
  display: flex;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx 16rpx 24rpx 16rpx;
  padding: 20rpx 0;
}
.stat {
  flex: 1;
  text-align: center;
}
.stat .num {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
}
.stat .lbl {
  font-size: 22rpx;
  opacity: 0.85;
}

.login-prompt {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 200rpx;
}
.login-text {
  font-size: 32rpx;
}

.section {
  margin: 20rpx 24rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin: 0 0 20rpx;
  color: var(--c-text);
  padding-left: 16rpx;
  position: relative;
}
.section-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: var(--grad-primary);
  border-radius: 3rpx;
}

.order-row {
  display: flex;
  background: var(--c-card);
  border-radius: 24rpx 16rpx 24rpx 16rpx;
  padding: 24rpx 12rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 24rpx;
}
.order-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: var(--c-text-soft);
  transition: transform 0.15s ease;
}
.order-item:active {
  transform: scale(0.95);
}
.o-icon {
  width: 84rpx;
  height: 84rpx;
  margin-bottom: 8rpx;
}

.menu-card {
  background: var(--c-card);
  border-radius: 24rpx 16rpx 24rpx 16rpx;
  box-shadow: var(--shadow-card);
  overflow: hidden;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: var(--c-fresh);
  border-radius: 24rpx 16rpx 24rpx 16rpx;
  margin-bottom: 12rpx;
  transition: transform 0.15s ease;
}
.menu-item:last-child {
  margin-bottom: 0;
}
.menu-item:active {
  transform: scale(0.98);
}
.arrow {
  color: var(--c-text-light);
  font-size: 36rpx;
  margin-left: auto;
}

.logout {
  margin: 40rpx 24rpx;
  background: var(--c-fresh);
  border-radius: 24rpx 16rpx 24rpx 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  color: var(--c-primary-dark);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(83, 111, 101, 0.16);
  transition: transform 0.15s ease;
}
.logout:active {
  transform: scale(0.98);
}
