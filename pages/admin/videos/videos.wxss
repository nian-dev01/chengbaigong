.page { padding: 20rpx 24rpx 140rpx; }
.item { background: #fff; border-radius: 16rpx; padding: 20rpx; margin-bottom: 16rpx; display: flex; align-items: center; }
.cover { width: 130rpx; height: 110rpx; border-radius: 10rpx; overflow: hidden; margin-right: 16rpx; }
.name { font-size: 28rpx; font-weight: bold; display: block; }
.meta { font-size: 22rpx; color: #999; display: block; margin-top: 4rpx; }
.ops { display: flex; flex-direction: column; gap: 10rpx; }
.op { font-size: 24rpx; color: #2b7fff; }
.op.del { color: var(--c-primary-dark); }
.fab { position: fixed; right: 30rpx; bottom: 40rpx; width: 100rpx; height: 100rpx; border-radius: 50%; background: linear-gradient(135deg,var(--c-primary-dark),var(--c-primary)); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 60rpx; box-shadow: 0 6rpx 20rpx rgba(200,22,29,0.4); }
.mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 100; }
.modal { width: 640rpx; background: #fff; border-radius: 20rpx; padding: 30rpx; max-height: 85vh; overflow-y: auto; }
.modal-title { font-size: 32rpx; font-weight: bold; text-align: center; margin-bottom: 20rpx; }
.m-item { display: flex; align-items: center; padding: 10rpx 0; }
.m-item.col { flex-direction: column; align-items: flex-start; }
.m-label { width: 100rpx; font-size: 26rpx; color: #333; }
.m-item.col .m-label { margin-bottom: 8rpx; }
.m-val { flex: 1; height: 70rpx; font-size: 26rpx; border-bottom: 1rpx solid #f2f2f2; }
.m-ta { width: 100%; height: 100rpx; font-size: 26rpx; background: #f5f5f5; border-radius: 10rpx; padding: 12rpx; box-sizing: border-box; }
.picker { font-size: 26rpx; color: #666; }
