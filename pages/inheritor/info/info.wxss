.form { background: #fff; border-radius: 16rpx; padding: 10rpx 30rpx; margin-bottom: 30rpx; }
.form-item { display: flex; align-items: center; min-height: 100rpx; border-bottom: 1rpx solid #f2f2f2; }
.form-item:last-child { border-bottom: none; }
.form-item.col { flex-direction: column; align-items: flex-start; padding: 20rpx 0; }
.label { font-size: 28rpx; color: #333; width: 140rpx; }
.form-item.col .label { width: auto; font-weight: bold; margin-bottom: 12rpx; }
.val { flex: 1; height: 100rpx; font-size: 28rpx; text-align: right; }
.textarea { width: 100%; height: 160rpx; font-size: 28rpx; }
