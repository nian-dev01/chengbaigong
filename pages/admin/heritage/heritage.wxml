<view class="page">
  <view class="list">
    <view class="item" wx:for="{{list}}" wx:key="id">
      <view class="cover"><cover text="{{item.name}}" seed="{{item.id}}" src="{{item.cover}}"></cover></view>
      <view class="info flex1">
        <text class="name ellipsis-1">{{item.name}}</text>
        <text class="meta">{{item.region}} · {{item.level}}</text>
        <text class="meta ellipsis-1">{{item.intro}}</text>
      </view>
      <view class="ops">
        <text class="op" bindtap="edit" data-item="{{item}}">编辑</text>
        <text class="op del" bindtap="del" data-id="{{item.id}}">删除</text>
      </view>
    </view>
    <view class="empty" wx:if="{{!list.length}}">暂无数据</view>
  </view>
  <view class="fab" bindtap="add">+</view>

  <view class="mask" wx:if="{{showModal}}" bindtap="closeModal">
    <view class="modal" catchtap="">
      <view class="modal-title">{{form.id?'编辑':'新增'}}非遗</view>
      <view class="m-item"><text class="m-label">名称</text><input class="m-val" value="{{form.name}}" bindinput="onInput" data-field="name"/></view>
      <view class="m-item"><text class="m-label">地区</text><input class="m-val" value="{{form.region}}" bindinput="onInput" data-field="region"/></view>
      <view class="m-item"><text class="m-label">级别</text>
        <picker mode="selector" range="{{levels}}" value="{{levelIdx}}" bindchange="onLevel">
          <view class="picker">{{form.level||'选择级别'}} ▾</view>
        </picker>
      </view>
      <view class="m-item"><text class="m-label">分类</text>
        <picker mode="selector" range="{{catNames}}" value="{{catIdx}}" bindchange="onCat">
          <view class="picker">{{catNames[catIdx]||'选择分类'}} ▾</view>
        </picker>
      </view>
      <view class="m-item col"><text class="m-label">简介</text><textarea class="m-ta" value="{{form.intro}}" bindinput="onInput" data-field="intro"/></view>
      <view class="m-item col"><text class="m-label">详情</text><textarea class="m-ta" style="height:160rpx" value="{{form.content}}" bindinput="onInput" data-field="content"/></view>
      <view class="row" style="gap:20rpx">
        <view class="btn-outline flex1" bindtap="closeModal">取消</view>
        <view class="btn-primary flex1" bindtap="save">保存</view>
      </view>
    </view>
  </view>
</view>
