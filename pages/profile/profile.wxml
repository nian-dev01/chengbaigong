<view class="page">
  <!-- 用户信息头部 -->
  <view class="header" wx:if="{{user}}">
    <view class="user-info row">
      <image class="avatar" wx:if="{{user.avatar}}" src="{{user.avatar}}" mode="aspectFill"></image>
      <view class="avatar" wx:else>{{user.nickname[0]}}</view>
      <view class="info flex1">
        <text class="nickname">{{user.nickname}}</text>
        <view class="role-tags">
          <text class="role-tag" wx:if="{{user.role==='user'}}">普通用户</text>
          <text class="role-tag role-inh" wx:if="{{user.role==='inheritor'}}">传承人</text>
          <text class="role-tag role-admin" wx:if="{{user.role==='admin'}}">管理员</text>
        </view>
      </view>
      <text class="edit" bindtap="goEdit">编辑</text>
    </view>
    <view class="stats row">
      <view class="stat" bindtap="goFavorites"><text class="num">{{favCount}}</text><text class="lbl">收藏</text></view>
      <view class="stat" bindtap="goMyPublish"><text class="num">{{publishCount}}</text><text class="lbl">发布</text></view>
      <view class="stat" bindtap="goOrders"><text class="num">{{orderCount}}</text><text class="lbl">订单</text></view>
      <view class="stat" bindtap="goMsg"><text class="num">{{unread}}</text><text class="lbl">消息</text></view>
    </view>
  </view>

  <view class="header login-prompt" wx:else bindtap="goLogin">
    <text class="login-text">点击登录 / 注册</text>
  </view>

  <!-- 我的订单 -->
  <view class="section card">
    <view class="section-title" style="margin-top:0">我的订单</view>
    <view class="order-row">
      <view class="order-item" bindtap="goOrders" data-status="pending"><image class="o-icon" src="/images/common/o_pay.png" mode="aspectFit" /><text>待付款</text></view>
      <view class="order-item" bindtap="goOrders" data-status="paid"><image class="o-icon" src="/images/common/o_ship.png" mode="aspectFit" /><text>待发货</text></view>
      <view class="order-item" bindtap="goOrders" data-status="shipped"><image class="o-icon" src="/images/common/o_receive.png" mode="aspectFit" /><text>待收货</text></view>
      <view class="order-item" bindtap="goOrders" data-status="completed"><image class="o-icon" src="/images/common/o_done.png" mode="aspectFit" /><text>已完成</text></view>
    </view>
  </view>

  <!-- 我的活动 -->
  <view class="section card">
    <view class="menu-item" bindtap="goMyActivities">
      <text class="flex1">我的活动</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goMyCourses">
      <text class="flex1">我的课程</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goAddress">
      <text class="flex1">收货地址</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goFavorites">
      <text class="flex1">我的收藏</text><text class="arrow">›</text>
    </view>
  </view>

  <!-- 更多服务 -->
  <view class="section card">
    <view class="menu-item" bindtap="goConsult">
      <text class="flex1">在线咨询</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goAnnouncement">
      <text class="flex1">系统公告</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goApplyInheritor">
      <text class="flex1">传承人申请</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goChangePwd">
      <text class="flex1">修改密码</text><text class="arrow">›</text>
    </view>
  </view>

  <!-- 角色入口 -->
  <view class="section card" wx:if="{{user && (user.role==='inheritor' || user.role==='admin')}}">
    <view class="menu-item" wx:if="{{user.role==='inheritor'}}" bindtap="goInheritorCenter">
      <text class="flex1">传承人工作台</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" wx:if="{{user.role==='admin'}}" bindtap="goAdminCenter">
      <text class="flex1">管理后台</text><text class="arrow">›</text>
    </view>
  </view>

  <view class="logout" wx:if="{{user}}" bindtap="doLogout">退出登录</view>
</view>
