/* orderDetail.wxss - 柔性自然系 v3 */
.page {
  padding: 24rpx 28rpx 180rpx;
  background: var(--grad-bg);
  min-height: 100vh;
}

/* === 状态头部 === */
.status-header {
  background: var(--grad-primary);
  border-radius: 28rpx 12rpx 28rpx 12rpx;
  padding: 48rpx 36rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(145, 203, 184, 0.25);
}
.status-bg-deco {
  position: absolute;
  width: 240rpx;
  height: 240rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 50%;
  top: -80rpx;
  right: -60rpx;
}
.status-icon {
  display: block;
  font-size: 64rpx;
  margin-bottom: 12rpx;
}
.status-text {
  display: block;
  font-size: 38rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 2rpx;
}
.status-sub {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 10rpx;
}

/* === 通用卡片 === */
.card {
  background: #fff;
  border-radius: 20rpx 16rpx 20rpx 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

/* === 地址卡片 === */
.addr-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  background: linear-gradient(135deg, #fff 0%, #f2faf6 100%);
}
.card-emoji {
  font-size: 36rpx;
  flex-shrink: 0;
}
.addr-top {
  display: flex;
  gap: 16rpx;
  margin-bottom: 6rpx;
}
.addr-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--c-text);
}
.addr-phone {
  font-size: 26rpx;
  color: var(--c-text-soft);
}
.addr-full {
  font-size: 26rpx;
  color: var(--c-text-soft);
  line-height: 1.6;
}

/* === 商品卡片 === */
.goods-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  gap: 16rpx;
  border-top: 1rpx dashed var(--c-moss);
}
.goods-item:first-child {
  border-top: none;
  padding-top: 4rpx;
}
.g-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 14rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.g-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.g-name {
  font-size: 26rpx;
  color: var(--c-text);
  line-height: 1.5;
}
.g-row-between {
  margin-top: auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 10rpx;
}
.g-price {
  font-size: 28rpx;
  color: var(--c-primary-dark);
  font-weight: bold;
}
.g-count {
  font-size: 24rpx;
  color: var(--c-text-light);
}

/* === 物流卡片 === */
.card-title-row {
  padding-bottom: 16rpx;
  border-bottom: 1rpx dashed var(--c-moss);
  margin-bottom: 16rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--c-text);
}
.logistics-company {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
}
.company-name {
  font-size: 26rpx;
  color: var(--c-text);
  font-weight: 500;
}
.company-no {
  font-size: 22rpx;
  color: var(--c-text-light);
}
.logistics-list {
  margin-top: 8rpx;
}
.log-item {
  display: flex;
  padding: 12rpx 0;
  position: relative;
}
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--c-moss);
  margin-right: 20rpx;
  margin-top: 8rpx;
  flex-shrink: 0;
}
.dot.first {
  background: var(--grad-primary);
  box-shadow: 0 0 0 4rpx rgba(145, 203, 184, 0.2);
}
.log-content {
  flex: 1;
}
.log-desc {
  font-size: 26rpx;
  color: var(--c-text);
  display: block;
}
.log-time {
  font-size: 22rpx;
  color: var(--c-text-light);
  display: block;
  margin-top: 4rpx;
}

/* === 订单信息 === */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}
.info-label {
  font-size: 26rpx;
  color: var(--c-text-soft);
}
.info-value {
  font-size: 26rpx;
  color: var(--c-text);
}
.info-value.muted {
  color: var(--c-text-light);
}
.divider-line {
  height: 1rpx;
  background: var(--c-moss);
  margin: 12rpx 0;
}
.info-row.total .info-label {
  font-size: 28rpx;
  color: var(--c-text);
  font-weight: 500;
}
.info-price {
  font-size: 36rpx;
  color: var(--c-primary-dark);
  font-weight: bold;
}

/* === 底部操作栏 === */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.98);
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  border-top: 1rpx solid var(--c-moss);
}
.action-btn {
  padding: 0 44rpx;
  height: 80rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}
