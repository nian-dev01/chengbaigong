.page { background: var(--grad-bg); }
.search { padding: 20rpx 24rpx; background: #fff; }
.search-input { background: #f5f5f5; border-radius: 40rpx; height: 72rpx; padding: 0 30rpx; font-size: 28rpx; }
.cat-bar { background: #fff; white-space: nowrap; padding: 10rpx 24rpx 20rpx; }
.cat-tab { display: inline-block; padding: 10rpx 28rpx; margin-right: 16rpx; background: #f5f5f5; border-radius: 30rpx; font-size: 26rpx; color: #666; }
.cat-tab.active { background: var(--c-primary-dark); color: #fff; }
.list { padding: 20rpx 24rpx; }
.card { background: #fff; border-radius: 16rpx; margin-bottom: 20rpx; overflow: hidden; }
.cover { height: 340rpx; position: relative; }
.duration { position: absolute; right: 16rpx; bottom: 16rpx; background: rgba(0,0,0,0.6); color: #fff; font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 8rpx; }
.info { padding: 20rpx; }
.title { font-size: 30rpx; font-weight: bold; }
.intro { font-size: 24rpx; color: #999; margin-top: 8rpx; line-height: 1.5; }
.meta { font-size: 22rpx; color: #bbb; margin-top: 10rpx; }
