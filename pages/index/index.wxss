/* index.wxss - 柔性自然系 v3 */

.page {
  background: linear-gradient(180deg, #f8f3e7 0%, #f0f7fa 30%, #eaf6e8 100%);
  padding-bottom: 60rpx;
  position: relative;
  overflow: hidden;
  min-height: 100vh;
}

/* === 装饰光斑 === */
.deco-blob {
  position: absolute;
  border-radius: 50%;
  opacity: 0.55;
  z-index: 0;
  pointer-events: none;
}
.deco-blob-1 {
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, #c1e4d2, transparent 70%);
  top: -120rpx;
  left: -100rpx;
}
.deco-blob-2 {
  width: 350rpx;
  height: 350rpx;
  background: radial-gradient(circle, #f0cfc1, transparent 70%);
  top: 80rpx;
  right: -100rpx;
}

/* === Header 搜索栏 === */
.header {
  padding: 24rpx 28rpx 12rpx;
  position: relative;
  z-index: 1;
}
.search-bar {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 48rpx 24rpx 48rpx 24rpx; /* 不规则圆角 */
  height: 72rpx;
  display: flex;
  align-items: center;
  padding: 0 12rpx 0 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(145, 203, 184, 0.12);
}
.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}
.search-placeholder {
  color: #95a89d;
  font-size: 26rpx;
  flex: 1;
}
.search-go {
  background: var(--grad-primary);
  color: #fff;
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  border-radius: 36rpx;
  box-shadow: 0 2rpx 12rpx rgba(145, 203, 184, 0.3);
}

/* === Banner === */
.banner {
  width: 100%;
  height: 360rpx;
  padding: 16rpx 28rpx 0;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}
.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 28rpx 16rpx 28rpx 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(145, 203, 184, 0.2);
}
.banner-cover {
  position: absolute;
  inset: 0;
}
.banner-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 28rpx 32rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.15) 100%);
  color: #fff;
  z-index: 2;
}
.banner-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}
.banner-sub {
  display: block;
  font-size: 24rpx;
  margin-top: 8rpx;
  opacity: 0.9;
}
.banner-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  z-index: 1;
}
.banner-circle-1 {
  width: 160rpx;
  height: 160rpx;
  top: -40rpx;
  right: -30rpx;
}
.banner-circle-2 {
  width: 80rpx;
  height: 80rpx;
  bottom: 60rpx;
  left: -20rpx;
}

/* === 快捷入口 === */
.quick-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 28rpx 20rpx 8rpx;
  background: transparent;
  position: relative;
  z-index: 1;
}
.quick-item {
  width: calc(100% / 4);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}
.quick-icon {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  overflow: hidden;
  position: relative;
  margin-bottom: 10rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.quick-icon-img {
  width: 100%;
  height: 100%;
}
.quick-label {
  font-size: 24rpx;
  color: var(--c-text);
  font-weight: 500;
}

/* 8个不同的不规则圆角和背景色 */
.quick-icon-1 {
  background: linear-gradient(135deg, #eaf6ef 0%, #d3e9df 100%);
  border-radius: 32rpx 16rpx 32rpx 16rpx;
}
.quick-icon-2 {
  background: linear-gradient(135deg, #f0f6f2 0%, #dbe9e3 100%);
  border-radius: 16rpx 32rpx 16rpx 32rpx;
}
.quick-icon-3 {
  background: linear-gradient(135deg, #f0f7f1 0%, #dceadb 100%);
  border-radius: 28rpx 12rpx 28rpx 12rpx;
}
.quick-icon-4 {
  background: linear-gradient(135deg, #eaf3f1 0%, #cfe3de 100%);
  border-radius: 12rpx 28rpx 12rpx 28rpx;
}
.quick-icon-5 {
  background: linear-gradient(135deg, #eef6f1 0%, #d8e8e0 100%);
  border-radius: 36rpx 20rpx 36rpx 20rpx;
}
.quick-icon-6 {
  background: linear-gradient(135deg, #edf4f0 0%, #d5e6de 100%);
  border-radius: 20rpx 36rpx 20rpx 36rpx;
}
.quick-icon-7 {
  background: linear-gradient(135deg, #eaf6ef 0%, #c9e4d9 100%);
  border-radius: 24rpx 16rpx 28rpx 12rpx;
}
.quick-icon-8 {
  background: linear-gradient(135deg, #f3f7ef 0%, #dde9d4 100%);
  border-radius: 16rpx 24rpx 12rpx 28rpx;
}

/* === 地图入口 === */
.map-entry {
  margin: 16rpx 28rpx 0;
  background: linear-gradient(135deg, #91cbb8 0%, #b8dccf 100%);
  border-radius: 28rpx 12rpx 28rpx 12rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8rpx 32rpx rgba(145, 203, 184, 0.25);
  position: relative;
  overflow: hidden;
  z-index: 1;
}
.map-bg-decor {
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 50%;
  top: -60rpx;
  right: -40rpx;
}
.map-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.map-emoji {
  font-size: 56rpx;
}
.map-text {
  display: flex;
  flex-direction: column;
}
.map-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 2rpx;
}
.map-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 6rpx;
}
.map-arrow {
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
}

/* === 通用区块 === */
.section {
  padding: 0 28rpx;
  position: relative;
  z-index: 1;
}

/* === 推荐非遗 === */
.heritage-list {
  padding-top: 8rpx;
}
.heritage-card {
  display: flex;
  background: #fff;
  border-radius: 24rpx 16rpx 24rpx 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
  transition: transform 0.2s ease;
}
.h-cover {
  width: 200rpx;
  height: 180rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  overflow: hidden;
}
.h-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.h-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--c-text);
}
.h-meta {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
}
.region {
  font-size: 22rpx;
  color: var(--c-text-light);
  margin-left: 14rpx;
}
.h-intro {
  font-size: 24rpx;
  color: var(--c-text-soft);
  margin-top: 12rpx;
  line-height: 1.6;
}

/* === 热门活动 横滑 === */
.activity-scroll {
  white-space: nowrap;
  padding-bottom: 8rpx;
}
.activity-card {
  display: inline-block;
  width: 270rpx;
  margin-right: 18rpx;
  background: #fff;
  border-radius: 20rpx 12rpx 20rpx 12rpx;
  vertical-align: top;
  overflow: hidden;
  box-shadow: var(--shadow-card);
  transition: transform 0.2s ease;
}
.a-cover {
  width: 270rpx;
  height: 180rpx;
}
.a-title {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  padding: 14rpx 18rpx 6rpx;
  color: var(--c-text);
}
.a-time,
.a-addr {
  display: block;
  font-size: 20rpx;
  color: var(--c-text-light);
  padding: 0 18rpx;
}
.a-addr {
  padding-bottom: 16rpx;
}

/* === 精选课程 === */
.course-list {
  padding-top: 8rpx;
}
.course-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx 24rpx 16rpx 24rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
  transition: transform 0.2s ease;
}
.c-cover {
  width: 200rpx;
  height: 140rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  overflow: hidden;
}
.c-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}
.c-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--c-text);
}
.c-teacher {
  font-size: 22rpx;
  color: var(--c-text-light);
  margin-top: 10rpx;
}
.c-bottom {
  margin-top: auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.c-price {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--c-primary-dark);
}
.students {
  font-size: 22rpx;
  color: var(--c-text-light);
}

/* === 底部留白 === */
.page-bottom {
  height: 120rpx;
}

/* === 悬浮在线咨询按钮 === */
.fab-consult {
  position: fixed;
  right: 28rpx;
  bottom: 180rpx;
  background: var(--grad-primary);
  color: #fff;
  padding: 16rpx 24rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 8rpx 28rpx rgba(145, 203, 184, 0.4);
  z-index: 100;
}
.fab-icon {
  font-size: 36rpx;
}
.fab-label {
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}
