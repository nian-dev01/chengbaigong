.page { padding: 40rpx 24rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 40rpx 30rpx; text-align: center; }
.title { font-size: 36rpx; font-weight: bold; }
.tip { display: block; font-size: 26rpx; color: #999; margin: 20rpx 0; }
.code-input { background: #f5f5f5; border-radius: 12rpx; height: 100rpx; text-align: center; font-size: 40rpx; letter-spacing: 6rpx; }
.result { margin-top: 30rpx; text-align: center; }
.result-icon { font-size: 100rpx; display: block; }
.result-text { font-size: 30rpx; color: var(--c-primary); margin-top: 10rpx; }
