<view class="page" wx:if="{{item}}">
  <view class="cover"><cover text="{{item.title}}" seed="{{item.id}}" src="{{item.cover}}"></cover></view>

  <view class="section card">
    <view class="title">{{item.title}}</view>
    <view class="meta-row">
      <text class="price" wx:if="{{item.price>0}}">¥{{item.price}}</text>
      <text class="price free" wx:else>免费</text>
      <text class="origin" wx:if="{{item.originalPrice>0}}">¥{{item.originalPrice}}</text>
      <text class="rating">⭐ {{item.rating}}</text>
      <text class="students">{{item.students}}人在学</text>
    </view>
    <view class="teacher-box">
      <view class="t-avatar">{{item.teacher[0]}}</view>
      <view class="t-info">
        <text class="t-name">{{item.teacher}}</text>
        <text class="t-tag">课程主讲</text>
      </view>
    </view>
  </view>

  <view class="section card">
    <view class="section-title" style="margin-top:0">课程简介</view>
    <view class="intro">{{item.intro}}</view>
    <view class="content">{{item.content}}</view>
  </view>

  <view class="section card">
    <view class="section-title" style="margin-top:0">课程目录（{{chapters.length}}讲）</view>
    <view class="chapter" wx:for="{{chapters}}" wx:key="id" bindtap="goLearn" data-id="{{item.id}}" data-chapter="{{item.id}}">
      <view class="ch-left">
        <text class="ch-order">{{item.order}}</text>
        <view>
          <text class="ch-title">{{item.title}}</text>
          <text class="ch-duration">时长 {{item.duration}}</text>
        </view>
      </view>
      <view class="ch-right">
        <text class="free-tag" wx:if="{{item.free}}">免费</text>
        <text class="lock" wx:elif="{{!bought}}">🔒</text>
        <text class="done" wx:elif="{{progressMap[item.id] && progressMap[item.id].finished}}">✅</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <view class="action" bindtap="toggleFav">
      <text class="a-icon">{{favorited?'❤️':'🤍'}}</text>
    </view>
    <view class="btn-primary flex1" wx:if="{{!bought}}" bindtap="buyCourse">{{item.price>0?'立即购买':'免费领取'}}</view>
    <view class="btn-primary flex1" wx:else bindtap="goLearn" data-id="{{item.id}}">继续学习</view>
  </view>
</view>
