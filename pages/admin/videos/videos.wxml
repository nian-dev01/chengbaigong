<view class="page">
  <view class="list">
    <view class="item" wx:for="{{list}}" wx:key="id">
      <view class="cover"><cover text="{{item.title}}" seed="{{item.id}}" src="{{item.cover}}"></cover></view>
      <view class="info flex1">
        <text class="name ellipsis-1">{{item.title}}</text>
        <text class="meta">{{item.duration}} · 👁{{item.views}}</text>
      </view>
      <view class="ops">
        <text class="op" bindtap="edit" data-item="{{item}}">编辑</text>
        <text class="op del" bindtap="del" data-id="{{item.id}}">删除</text>
      </view>
    </view>
    <view class="empty" wx:if="{{!list.length}}">暂无数据</view>
  </view>
  <view class="fab" bindtap="add">+</view>

  <view class="mask" wx:if="{{showModal}}" bindtap="closeModal">
    <view class="modal" catchtap="">
      <view class="modal-title">{{form.id?'编辑':'新增'}}视频</view>
      <view class="m-item"><text class="m-label">标题</text><input class="m-val" value="{{form.title}}" bindinput="onInput" data-field="title"/></view>
      <view class="m-item"><text class="m-label">时长</text><input class="m-val" value="{{form.duration}}" bindinput="onInput" data-field="duration" placeholder="如 08:30"/></view>
      <view class="m-item"><text class="m-label">类型</text>
        <picker mode="selector" range="{{typeNames}}" value="{{typeIdx}}" bindchange="onType">
          <view class="picker">{{typeNames[typeIdx]||'选择'}} ▾</view>
        </picker>
      </view>
      <view class="m-item col"><text class="m-label">简介</text><textarea class="m-ta" value="{{form.intro}}" bindinput="onInput" data-field="intro"/></view>
      <view class="row" style="gap:20rpx">
        <view class="btn-outline flex1" bindtap="closeModal">取消</view>
        <view class="btn-primary flex1" bindtap="save">保存</view>
      </view>
    </view>
  </view>
</view>
