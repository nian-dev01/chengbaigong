<view class="page">
  <view class="card">
    <view class="section-title" style="margin-top:0">核心指标</view>
    <view class="metric-grid">
      <view class="metric"><text class="num">{{stats.userCount}}</text><text class="lbl">用户总数</text></view>
      <view class="metric"><text class="num">{{stats.inheritorCount}}</text><text class="lbl">传承人</text></view>
      <view class="metric"><text class="num">{{stats.heritageCount}}</text><text class="lbl">非遗项目</text></view>
      <view class="metric"><text class="num">{{stats.videoCount}}</text><text class="lbl">视频数</text></view>
      <view class="metric"><text class="num">{{stats.activityCount}}</text><text class="lbl">活动数</text></view>
      <view class="metric"><text class="num">{{stats.courseCount}}</text><text class="lbl">课程数</text></view>
      <view class="metric"><text class="num">{{stats.orderCount}}</text><text class="lbl">订单数</text></view>
      <view class="metric"><text class="num">¥{{stats.totalSales}}</text><text class="lbl">销售额</text></view>
    </view>
  </view>

  <view class="card">
    <view class="section-title" style="margin-top:0">非遗类别分布（ECharts 模拟）</view>
    <view class="chart">
      <view class="bar-row" wx:for="{{stats.categoryStat}}" wx:key="name">
        <text class="bar-name">{{item.name}}</text>
        <view class="bar-track"><view class="bar-fill" style="width:{{item.value>0?(item.value/maxCat*100):0}}%"></view></view>
        <text class="bar-val">{{item.value}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title" style="margin-top:0">运营概览</view>
    <view class="overview">
      <view class="ov-item"><text class="ov-icon">🏛️</text><text>非遗项目 {{stats.heritageCount}} 项</text></view>
      <view class="ov-item"><text class="ov-icon">🎬</text><text>视频内容 {{stats.videoCount}} 条</text></view>
      <view class="ov-item"><text class="ov-icon">🎉</text><text>文化活动 {{stats.activityCount}} 场</text></view>
      <view class="ov-item"><text class="ov-icon">📚</text><text>在线课程 {{stats.courseCount}} 门</text></view>
      <view class="ov-item"><text class="ov-icon">💬</text><text>话题讨论 {{stats.topicCount}} 条</text></view>
      <view class="ov-item"><text class="ov-icon">📦</text><text>累计订单 {{stats.orderCount}} 笔</text></view>
    </view>
  </view>

  <view class="card">
    <view class="section-title" style="margin-top:0">用户角色占比</view>
    <view class="pie-row">
      <view class="pie-seg" style="flex:{{stats.userCount}}" wx:if="{{stats.userCount}}"><view class="seg user"></view><text>用户{{stats.userCount}}</text></view>
      <view class="pie-seg" style="flex:{{stats.inheritorCount}}" wx:if="{{stats.inheritorCount}}"><view class="seg inh"></view><text>传承人{{stats.inheritorCount}}</text></view>
      <view class="pie-seg" style="flex:1" wx:if="{{stats.adminCount}}"><view class="seg admin"></view><text>管理员{{stats.adminCount}}</text></view>
    </view>
  </view>
</view>
