/* addressList.wxss - 柔性自然系 v3 */
.page {
  padding: 24rpx 28rpx 200rpx;
  background: var(--grad-bg);
  min-height: 100vh;
}

/* === 页面头部 === */
.page-header {
  padding: 20rpx 0 32rpx;
}
.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--c-text);
}
.header-sub {
  display: block;
  font-size: 24rpx;
  color: var(--c-text-light);
  margin-top: 8rpx;
}

/* === 地址卡片 === */
.addr-card {
  background: #fff;
  border-radius: 24rpx 16rpx 24rpx 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  position: relative;
  overflow: hidden;
}
.addr-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  background: var(--grad-primary);
  opacity: 0.5;
}

/* === 选中圆圈 === */
.select-circle {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid var(--c-moss);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
  transition: all 0.25s ease;
}
.select-circle.on {
  background: var(--grad-primary);
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(145, 203, 184, 0.4);
}
.circle-inner {
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
}

/* === 地址主内容 === */
.addr-main {
  flex: 1;
  min-width: 0;
}
.addr-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}
.addr-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--c-text);
}
.addr-phone {
  font-size: 28rpx;
  color: var(--c-text-soft);
}
.default-tag {
  background: var(--grad-primary);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  margin-left: 4rpx;
}
.addr-detail-row {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.addr-region {
  font-size: 26rpx;
  color: var(--c-primary-dark);
  font-weight: 500;
}
.addr-detail {
  font-size: 26rpx;
  color: var(--c-text-soft);
  line-height: 1.6;
}

/* === 操作区 === */
.addr-actions {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed var(--c-moss);
  margin-left: 64rpx;
}
.action-row {
  display: flex;
  gap: 36rpx;
}
.action-item,
.action-del {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: var(--c-text-soft);
}
.action-del {
  color: var(--c-accent-deep);
}
.action-icon {
  font-size: 26rpx;
}

/* === 设为默认 === */
.set-default-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed var(--c-moss);
}
.set-default-row.is-default .checkbox {
  background: var(--grad-primary);
  border-color: transparent;
}
.checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid var(--c-moss);
  flex-shrink: 0;
  transition: all 0.2s;
}
.checkbox.on {
  background: var(--grad-primary);
  border-color: transparent;
  box-shadow: 0 2rpx 8rpx rgba(145, 203, 184, 0.3);
}
.set-default-text {
  font-size: 24rpx;
  color: var(--c-text-soft);
}
.set-default-row.is-default .set-default-text {
  color: var(--c-primary-dark);
}

/* === 底部按钮 === */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid var(--c-moss);
}
.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 92rpx;
  font-size: 30rpx;
  letter-spacing: 2rpx;
}
.add-icon {
  font-size: 36rpx;
  font-weight: bold;
}
