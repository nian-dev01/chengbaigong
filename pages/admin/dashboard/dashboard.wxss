.page { padding-bottom: 40rpx; }
.header { background: linear-gradient(135deg,var(--c-primary-dark),var(--c-primary)); padding: 40rpx 30rpx; color: #fff; }
.title { font-size: 36rpx; font-weight: bold; display: block; }
.sub { font-size: 24rpx; opacity: 0.85; margin-top: 6rpx; display: block; }
.stat-grid { display: flex; flex-wrap: wrap; margin: -20rpx 24rpx 0; }
.stat-card { width: 25%; background: #fff; border-radius: 16rpx; padding: 24rpx 0; text-align: center; box-sizing: border-box; border: 1rpx solid #f5f5f5; }
.stat-card .num { font-size: 36rpx; font-weight: bold; color: var(--c-primary-dark); display: block; }
.stat-card .lbl { font-size: 22rpx; color: #999; display: block; margin-top: 6rpx; }
.menu { margin: 20rpx 24rpx; background: #fff; border-radius: 16rpx; }
.m-item { display: flex; align-items: center; padding: 28rpx 24rpx; border-bottom: 1rpx solid #f5f5f5; font-size: 28rpx; }
.m-item:last-child { border-bottom: none; }
.m-item text:first-child { font-size: 36rpx; margin-right: 16rpx; }
.m-item text:nth-child(2) { flex: 1; }
.arrow { color: #ccc; font-size: 32rpx; }
.card { margin: 20rpx 24rpx; }
.back { color: var(--c-primary-dark); font-size: 28rpx; }
