<view class="page">
  <view class="card" bindtap="goConsult">
    <view class="row">
      <view class="icon blue">💬</view>
      <view class="flex1">
        <text class="name">在线咨询</text>
        <text class="sub">与传承人或客服沟通</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>
  <view class="card" bindtap="goAnnouncement">
    <view class="row">
      <view class="icon orange">📢</view>
      <view class="flex1">
        <text class="name">系统公告</text>
        <text class="sub">平台最新动态</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>
  <view class="empty">暂无新消息</view>
</view>
