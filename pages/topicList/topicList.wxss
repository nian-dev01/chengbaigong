.page {
  background: var(--grad-bg);
  padding-bottom: 30rpx;
  min-height: 100vh;
}
.cat-bar {
  background: transparent;
  white-space: nowrap;
  padding: 20rpx 24rpx;
}
.cat-tab {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
}
.cat-tab.active {
  background: var(--c-primary-dark);
  color: #fff;
}
.list {
  padding: 20rpx 24rpx;
}
.topic-card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.user-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}
.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--c-primary-dark), var(--c-primary));
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  margin-right: 14rpx;
}
.u-name {
  font-size: 28rpx;
  font-weight: bold;
  display: block;
}
.u-time {
  font-size: 22rpx;
  color: #999;
  display: block;
}
.u-info {
  flex: 1;
}
.t-title {
  font-size: 30rpx;
  font-weight: bold;
  display: block;
}
.t-content {
  font-size: 26rpx;
  color: #666;
  margin-top: 10rpx;
  line-height: 1.6;
  display: block;
}
.t-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
.metas {
  display: flex;
  gap: 30rpx;
}
.meta {
  font-size: 22rpx;
  color: #999;
}
.del {
  font-size: 22rpx;
  color: #C0392B;
  padding: 6rpx 20rpx;
  border: 1rpx solid #E6B8B2;
  border-radius: 24rpx;
}
.fab {
  position: fixed;
  right: 30rpx;
  bottom: 40rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--c-primary-dark), var(--c-primary));
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  box-shadow: 0 6rpx 20rpx rgba(200, 22, 29, 0.4);
}
