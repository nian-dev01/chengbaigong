.page {background: var(--grad-bg);
 min-height: 100vh; padding: 60rpx 40rpx; box-sizing: border-box; }
.result-box { background: #fff; border-radius: 20rpx; padding: 60rpx 40rpx; text-align: center; }
.result-icon { font-size: 100rpx; }
.result-title { font-size: 34rpx; font-weight: bold; margin-top: 20rpx; }
.amount { font-size: 56rpx; color: var(--c-primary-dark); font-weight: bold; margin: 20rpx 0 40rpx; }
.pay-methods { display: flex; justify-content: center; gap: 30rpx; }
.method { display: flex; flex-direction: column; align-items: center; padding: 20rpx 30rpx; border: 2rpx solid #eee; border-radius: 16rpx; font-size: 24rpx; color: #666; }
.method.active { border-color: var(--c-primary-dark); background: #fdecec; color: var(--c-primary-dark); }
.m-icon { font-size: 50rpx; margin-bottom: 8rpx; }
