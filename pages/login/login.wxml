<view class="login-page">
  <view class="logo">
    <text class="app-name">非遗传承</text>
    <text class="slogan">匠心千年 · 文化不灭</text>
  </view>

  <view class="form">
    <view class="input-box">
      <text class="label">账号</text>
      <input placeholder="请输入用户名" value="{{username}}" bindinput="onInput" data-field="username" />
    </view>
    <view class="input-box">
      <text class="label">密码</text>
      <input placeholder="请输入密码" password value="{{password}}" bindinput="onInput" data-field="password" />
    </view>
    <view class="btn-primary mt-30" bindtap="doLogin">登 录</view>
    <view class="btn-wechat" bindtap="onWechatLogin">
      <view class="wx-ico">微</view>
      <text>微信一键登录</text>
    </view>
    <view class="links between mt-20">
      <text class="link" bindtap="goRegister">注册账号</text>
      <text class="link" bindtap="goForget">忘记密码？</text>
    </view>
  </view>
</view>
