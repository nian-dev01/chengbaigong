.page {
  padding-bottom: 140rpx;
  background: var(--grad-bg);
  min-height: 100vh;
}
.cover {
  height: 360rpx;
  box-shadow: var(--shadow-card);
}

.card-section {
  background: var(--c-card);
  border-radius: 24rpx 16rpx 24rpx 16rpx;
  margin: 20rpx 24rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-card);
}

.section {
  margin: 20rpx 24rpx;
}
.title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--c-text);
}
.info-list {
  margin-top: 16rpx;
}
.info-item {
  display: flex;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: var(--c-text);
}
.info-item .lbl {
  width: 120rpx;
  color: var(--c-text-light);
}
.intro {
  font-size: 28rpx;
  color: var(--c-text);
  line-height: 1.8;
}

.reg-status {
  display: flex;
  gap: 10rpx;
  margin-bottom: 20rpx;
}
.signin-box {
  background: var(--c-fresh);
  border-radius: 24rpx 16rpx 24rpx 16rpx;
  padding: 30rpx;
  text-align: center;
}
.signin-label {
  font-size: 24rpx;
  color: var(--c-text-light);
}
.signin-code {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  color: var(--c-primary-dark);
  letter-spacing: 8rpx;
  margin: 16rpx 0;
}
.signin-tip {
  font-size: 22rpx;
  color: var(--c-text-light);
}
.rating {
  font-size: 28rpx;
  color: var(--c-primary-dark);
}
.comment {
  font-size: 26rpx;
  color: var(--c-text-soft);
  margin-top: 10rpx;
  font-style: italic;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.98);
  padding: 16rpx 24rpx;
  display: flex;
  border-top: 1rpx solid var(--c-moss);
  z-index: 10;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(61, 81, 72, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.modal {
  width: 600rpx;
  background: var(--c-card);
  border-radius: 24rpx 16rpx 24rpx 16rpx;
  padding: 40rpx 30rpx;
  box-shadow: var(--shadow-hover);
}
.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 20rpx;
  color: var(--c-text);
}
.stars {
  text-align: center;
  margin-bottom: 20rpx;
}
.star {
  font-size: 60rpx;
  color: var(--c-moss);
  margin: 0 8rpx;
  transition: color 0.2s ease;
}
.star.on {
  color: var(--c-gold);
}
.comment-input {
  width: 100%;
  height: 160rpx;
  background: var(--c-fresh);
  border: 1rpx solid var(--c-moss);
  border-radius: 16rpx 10rpx 16rpx 10rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  margin-bottom: 20rpx;
  color: var(--c-text);
}
