<view class="page" wx:if="{{item}}">
  <view class="cover">
    <cover text="{{item.name}}" seed="{{item.id}}" src="{{item.cover}}"></cover>
    <view class="cover-meta">
      <text class="tag tag-red">{{item.level}}</text>
      <text class="region">📍 {{item.region}}</text>
    </view>
  </view>

  <view class="section card">
    <view class="title">{{item.name}}</view>
    <view class="meta-row">
      <text>👁 {{item.views}} 浏览</text>
      <text>❤️ {{item.likes}} 收藏</text>
    </view>
    <view class="divider"></view>
    <view class="content">{{item.intro}}</view>
    <view class="content">{{item.content}}</view>
  </view>

  <view class="section card" wx:if="{{inheritor}}" bindtap="goInheritor" data-id="{{inheritor.id}}">
    <view class="section-title" style="margin-top:0">传承人</view>
    <view class="row">
      <view class="inh-avatar">{{inheritor.name[0]}}</view>
      <view class="flex1">
        <text class="inh-name">{{inheritor.name}}</text>
        <text class="inh-title">{{inheritor.title}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="bottom-bar between">
    <view class="action" bindtap="toggleFav">
      <text class="a-icon">{{favorited?'❤️':'🤍'}}</text>
      <text>{{favorited?'已收藏':'收藏'}}</text>
    </view>
    <view class="action" bindtap="share">
      <text class="a-icon">📤</text><text>分享</text>
    </view>
    <view class="btn-primary btn-bottom" bindtap="consult">咨询传承人</view>
  </view>
</view>
