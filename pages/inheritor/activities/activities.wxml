<view class="page">
  <view class="list">
    <view class="item" wx:for="{{list}}" wx:key="id">
      <view class="cover"><cover text="{{item.title}}" seed="{{item.id}}" src="{{item.cover}}"></cover></view>
      <view class="info flex1">
        <text class="title ellipsis-1">{{item.title}}</text>
        <text class="meta">{{item.startTime}}</text>
        <text class="meta">报名 {{item.joined}}/{{item.maxPeople}}</text>
      </view>
      <view class="ops">
        <text class="op" bindtap="edit" data-item="{{item}}">编辑</text>
        <text class="op del" bindtap="del" data-id="{{item.id}}">删除</text>
      </view>
    </view>
    <view class="empty" wx:if="{{!list.length}}">暂无活动</view>
  </view>
  <view class="fab" bindtap="add">+</view>

  <view class="mask" wx:if="{{showModal}}" bindtap="closeModal">
    <view class="modal" catchtap="">
      <view class="modal-title">{{form.id?'编辑':'发布'}}活动</view>
      <view class="m-item"><text class="m-label">标题</text><input class="m-val" value="{{form.title}}" bindinput="onInput" data-field="title"/></view>
      <view class="m-item"><text class="m-label">地区</text><input class="m-val" value="{{form.region}}" bindinput="onInput" data-field="region"/></view>
      <view class="m-item"><text class="m-label">地址</text><input class="m-val" value="{{form.address}}" bindinput="onInput" data-field="address"/></view>
      <view class="m-item"><text class="m-label">开始</text><input class="m-val" value="{{form.startTime}}" bindinput="onInput" data-field="startTime" placeholder="2024-06-15 09:00:00"/></view>
      <view class="m-item"><text class="m-label">结束</text><input class="m-val" value="{{form.endTime}}" bindinput="onInput" data-field="endTime"/></view>
      <view class="m-item"><text class="m-label">名额</text><input class="m-val" type="number" value="{{form.maxPeople}}" bindinput="onInput" data-field="maxPeople"/></view>
      <view class="m-item col"><text class="m-label">介绍</text><textarea class="m-ta" value="{{form.intro}}" bindinput="onInput" data-field="intro"/></view>
      <view class="row" style="gap:20rpx">
        <view class="btn-outline flex1" bindtap="closeModal">取消</view>
        <view class="btn-primary flex1" bindtap="save">保存</view>
      </view>
    </view>
  </view>
</view>
