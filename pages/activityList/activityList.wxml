<view class="page">
  <view class="search">
    <input class="search-input" placeholder="搜索非遗活动" value="{{keyword}}" bindinput="onSearch"/>
  </view>
  <view class="list">
    <view class="card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="cover">
        <cover text="{{item.title}}" seed="{{item.id}}" src="{{item.cover}}"></cover>
        <view class="badge" wx:if="{{item.joined>=item.maxPeople}}">已满</view>
      </view>
      <view class="info">
        <text class="title ellipsis-1">{{item.title}}</text>
        <view class="meta-row"><text class="tag tag-orange">活动</text><text class="region">📍 {{item.region}}</text></view>
        <text class="time">🕐 {{item.startTime}}</text>
        <view class="bottom between">
          <text class="joined">已报名 {{item.joined}}/{{item.maxPeople}} 人</text>
          <text class="btn-detail">查看详情 ›</text>
        </view>
      </view>
    </view>
    <view class="empty" wx:if="{{!list.length}}">暂无活动</view>
  </view>
</view>
