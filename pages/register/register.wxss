.register-page {
  min-height: 100vh;
  background: var(--grad-bg);
  padding: 40rpx 48rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}
.register-page::before {
  content: '';
  position: absolute;
  width: 360rpx; height: 360rpx;
  background: radial-gradient(circle, rgba(240,207,193,0.4) 0%, transparent 70%);
  top: -120rpx; left: -100rpx;
  border-radius: 50%;
  pointer-events: none;
}
.register-page::after {
  content: '';
  position: absolute;
  width: 280rpx; height: 280rpx;
  background: radial-gradient(circle, rgba(184,220,207,0.45) 0%, transparent 70%);
  bottom: -60rpx; right: -40rpx;
  border-radius: 50%;
  pointer-events: none;
}

.form {
  background: var(--c-card);
  border-radius: 24rpx 16rpx 24rpx 16rpx;
  padding: 40rpx 30rpx;
  margin-top: 40rpx;
  box-shadow: var(--shadow-card);
  position: relative; z-index: 1;
}
.input-box {
  background: var(--c-fresh);
  border: 1rpx solid var(--c-moss);
  border-radius: 16rpx 10rpx 16rpx 10rpx;
  padding: 0 20rpx;
  height: 90rpx;
  display: flex; align-items: center;
  margin-bottom: 24rpx;
  transition: border-color 0.2s ease, background 0.2s ease;
}
.input-box:focus-within {
  border-color: var(--c-primary);
  background: #fff;
}
.input-box .label { font-size: 28rpx; color: var(--c-text-soft); width: 110rpx; }
.input-box input { flex: 1; height: 90rpx; font-size: 28rpx; color: var(--c-text); }
.link { color: var(--c-primary-dark); font-size: 26rpx; }
