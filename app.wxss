/* app.wxss 全局样式 - 柔性自然系配色 v3 */

page {
  /* === 主色系 - 柔性薄荷 === */
  --c-primary: #91cbb8; /* 生命青绿 - 主色 */
  --c-primary-light: #b8dccf; /* 柔性薄荷 - 主色浅 */
  --c-primary-dark: #536f65; /* 苔藓深绿 - 主色深 */

  /* === 点缀色 === */
  --c-accent: #f0cfc1; /* 培养粉 - 暖调点缀 */
  --c-accent-deep: #e8c7d1; /* 组织淡粉 - 粉系深 */
  --c-gold: #d4b896; /* 温润金 - 次点缀 */

  /* === 辅助绿系 === */
  --c-mint: #c1e4d2; /* 薄荷嫩叶 */
  --c-moss: #d8e8d0; /* 菌落米绿 */
  --c-fresh: #eaf6e8; /* 雾岛白绿 */

  /* === 蓝灰系 === */
  --c-bluegray: #718c9b; /* 标本蓝灰 */
  --c-lightblue: #c7e4ec; /* 透明浅蓝 */

  /* === 背景 === */
  --c-bg: #f8f3e7; /* 培养皿白 - 主背景 */
  --c-bg-soft: #f4f6df; /* 苔芽白 - 次背景 */
  --c-card: #ffffff; /* 卡片白 */

  /* === 文字 === */
  --c-text: #3d5148; /* 墨绿灰 - 主文字 */
  --c-text-soft: #6b7e75; /* 柔绿灰 - 次文字 */
  --c-text-light: #95a89d; /* 淡绿灰 - 辅助文字 */
  --c-text-white: #ffffff;

  /* === 渐变 === */
  --grad-primary: linear-gradient(135deg, #b8dccf 0%, #91cbb8 100%);
  --grad-warm: linear-gradient(135deg, #f0cfc1 0%, #e8c7d1 100%);
  --grad-bg: linear-gradient(180deg, #faf6ec 0%, #f5f3e8 45%, #eaf5eb 100%);
  --grad-card: linear-gradient(145deg, #ffffff 0%, #f8f3e7 100%);

  /* === 阴影 === */
  --shadow-soft: 0 4rpx 20rpx rgba(145, 203, 184, 0.12);
  --shadow-hover: 0 8rpx 32rpx rgba(145, 203, 184, 0.22);
  --shadow-card: 0 2rpx 16rpx rgba(61, 81, 72, 0.06);

  font-family: "PingFang SC", "STHeiti", "Microsoft YaHei", sans-serif;
  font-size: 26rpx;
  line-height: 1.6;
  background: var(--c-bg);
  color: var(--c-text);
}

/* === 布局工具类 === */
.container {
  padding: 24rpx;
  box-sizing: border-box;
}
/* 页面根容器铺满全屏，渐变背景不再分层 */
.page {
  min-height: 100vh;
  box-sizing: border-box;
}
.row {
  display: flex;
  align-items: center;
}
.col {
  display: flex;
  flex-direction: column;
}
.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flex1 {
  flex: 1;
  min-width: 0;
}
.gap-s {
  gap: 12rpx;
}
.gap-m {
  gap: 20rpx;
}
.gap-l {
  gap: 32rpx;
}

/* === 文字工具类 === */
.text-primary {
  color: var(--c-primary);
}
.text-primary-dark {
  color: var(--c-primary-dark);
}
.text-accent {
  color: var(--c-accent-deep);
}
.text-gold {
  color: var(--c-gold);
}
.text-muted {
  color: var(--c-text-light);
}
.text-soft {
  color: var(--c-text-soft);
}
.text-center {
  text-align: center;
}
.text-bold {
  font-weight: bold;
}
.text-price {
  color: var(--c-primary-dark);
  font-weight: bold;
}

/* === 标签 === */
.tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  margin-right: 10rpx;
  line-height: 1.4;
}
.tag-primary {
  background: var(--grad-primary);
  color: #fff;
}
.tag-accent {
  background: var(--grad-warm);
  color: #fff;
}
.tag-moss {
  background: var(--c-moss);
  color: var(--c-primary-dark);
}
.tag-blue {
  background: var(--c-lightblue);
  color: var(--c-bluegray);
}
.tag-soft {
  background: var(--c-fresh);
  color: var(--c-primary-dark);
}

/* === 按钮 === */
.btn-primary {
  background: var(--grad-primary);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  letter-spacing: 4rpx;
  box-shadow: var(--shadow-soft);
  transition: all 0.25s ease;
}
.btn-primary::after {
  border: none;
}

.btn-warm {
  background: var(--grad-warm);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  letter-spacing: 4rpx;
  box-shadow: 0 4rpx 20rpx rgba(240, 207, 193, 0.3);
}
.btn-warm::after {
  border: none;
}

.btn-ghost {
  background: transparent;
  color: var(--c-primary-dark);
  border: 2rpx solid var(--c-primary-light);
  border-radius: 40rpx;
  font-size: 26rpx;
  height: 72rpx;
  line-height: 68rpx;
  text-align: center;
}
.btn-ghost::after {
  border: none;
}

/* === 卡片 === */
.card {
  background: var(--c-card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}
.card-soft {
  background: var(--grad-card);
  border-radius: 24rpx 16rpx 24rpx 16rpx; /* 不规则圆角 */
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}
.card-warm {
  background: linear-gradient(145deg, #fff9f5 0%, #fff0eb 100%);
  border-radius: 16rpx 24rpx 16rpx 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(240, 207, 193, 0.12);
}
.card-green {
  background: linear-gradient(145deg, #f2faf6 0%, #eaf6e8 100%);
  border-radius: 20rpx 12rpx 20rpx 12rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(145, 203, 184, 0.1);
}

/* === 标题 === */
.section-title {
  display: flex;
  align-items: center;
  margin: 48rpx 0 28rpx;
  font-size: 34rpx;
  font-weight: bold;
  color: var(--c-text);
  padding-left: 20rpx;
  position: relative;
}
.section-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  background: var(--grad-primary);
  border-radius: 4rpx;
}
.section-title .more {
  font-size: 24rpx;
  color: var(--c-text-light);
  font-weight: normal;
  margin-left: auto;
}

/* === 省略号 === */
.ellipsis-1 {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* === 空状态 === */
.empty {
  text-align: center;
  color: var(--c-text-light);
  padding: 120rpx 0;
  font-size: 26rpx;
}
.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

/* === 分割线 === */
.divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--c-moss), transparent);
  margin: 24rpx 0;
}

/* === 底部固定栏 === */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.98);
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(216, 232, 208, 0.5);
  z-index: 99;
}

/* === 触碰反馈效果 === */
.tap-scale {
  transition: transform 0.15s ease;
}
.tap-scale:active {
  transform: scale(0.97);
}
.tap-opacity {
  transition: opacity 0.15s ease;
}
.tap-opacity:active {
  opacity: 0.7;
}

/* === 圆角不规则装饰 === */
.rounded-a {
  border-radius: 32rpx 16rpx 32rpx 16rpx;
}
.rounded-b {
  border-radius: 16rpx 32rpx 16rpx 32rpx;
}
.rounded-c {
  border-radius: 24rpx 8rpx 24rpx 8rpx;
}
