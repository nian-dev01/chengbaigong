.page {
  padding-bottom: 30rpx;
  background: var(--grad-bg);
  min-height: 100vh;
}
.search {
  padding: 20rpx 24rpx;
  background: var(--c-moss);
}
.search-input {
  background: var(--c-card);
  border-radius: 40rpx;
  height: 72rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: var(--c-text);
  transition: border-color 0.2s ease;
}
.cat-bar {
  background: var(--c-moss);
  white-space: nowrap;
  padding: 10rpx 24rpx 20rpx;
}
.cat-tab {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  background: var(--c-fresh);
  border-radius: 30rpx;
  font-size: 26rpx;
  color: var(--c-text-soft);
  transition: all 0.2s ease;
}
.cat-tab.active {
  background: var(--grad-primary);
  color: #fff;
  box-shadow: var(--shadow-soft);
}
.list {
  padding: 20rpx 24rpx;
}
.card {
  background: var(--c-card);
  border-radius: 24rpx 16rpx 24rpx 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  display: flex;
  border: 1rpx solid var(--c-fresh);
  box-shadow: var(--shadow-card);
  transition:
    transform 0.15s ease,
    box-shadow 0.2s ease;
}
.card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-soft);
}
.cover {
  width: 220rpx;
  height: 200rpx;
  flex-shrink: 0;
}
.info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
}
.name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--c-text);
}
.region {
  font-size: 24rpx;
  color: var(--c-text-light);
  margin-top: 8rpx;
}
.intro {
  font-size: 24rpx;
  color: var(--c-text-soft);
  margin-top: 8rpx;
  line-height: 1.5;
}
.bottom {
  margin-top: auto;
}
.meta {
  font-size: 22rpx;
  color: var(--c-text-light);
}
