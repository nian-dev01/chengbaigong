<view class="page">
  <view class="tabs">
    <text class="tab {{type==='heritage'?'active':''}}" bindtap="setType" data-v="heritage">非遗</text>
    <text class="tab {{type==='video'?'active':''}}" bindtap="setType" data-v="video">视频</text>
    <text class="tab {{type==='course'?'active':''}}" bindtap="setType" data-v="course">课程</text>
    <text class="tab {{type==='topic'?'active':''}}" bindtap="setType" data-v="topic">话题</text>
    <text class="tab {{type==='product'?'active':''}}" bindtap="setType" data-v="product">商品</text>
  </view>
  <view class="list">
    <view class="card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="cover"><cover text="{{item.name||item.title}}" seed="{{item.id}}" src="{{item.cover}}"></cover></view>
      <view class="info">
        <text class="name ellipsis-1">{{item.name||item.title}}</text>
        <text class="sub ellipsis-1">{{item.intro||item.content}}</text>
      </view>
    </view>
    <view class="empty" wx:if="{{!list.length}}">暂无收藏</view>
  </view>
</view>
