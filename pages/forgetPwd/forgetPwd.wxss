.page { background: var(--grad-bg); }
.form { background: #fff; border-radius: 20rpx; padding: 40rpx 30rpx; margin-top: 40rpx; }
.input-box { background: #f5f5f5; border-radius: 12rpx; padding: 0 20rpx; height: 90rpx; display: flex; align-items: center; margin-bottom: 24rpx; }
.input-box .label { font-size: 28rpx; color: #666; width: 110rpx; }
.input-box input { flex: 1; height: 90rpx; font-size: 28rpx; }
.code-btn { color: var(--c-primary-dark); font-size: 24rpx; padding: 10rpx 20rpx; }
