.page { padding: 20rpx 24rpx; }
.item { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.name { font-size: 30rpx; font-weight: bold; flex: 1; }
.content { font-size: 26rpx; color: #666; margin-top: 10rpx; line-height: 1.6; display: block; }
.meta-row { display: flex; gap: 20rpx; margin-top: 12rpx; font-size: 22rpx; color: #999; }
.ops { display: flex; gap: 16rpx; margin-top: 20rpx; }
.pass, .reject { flex: 1; text-align: center; padding: 14rpx 0; border-radius: 30rpx; font-size: 26rpx; }
.pass { background: var(--c-primary); color: #fff; }
.reject { background: var(--c-primary-dark); color: #fff; }
