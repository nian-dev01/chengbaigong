.page { background: var(--grad-bg); }
.tabs { background: #fff; display: flex; padding: 0 10rpx; position: sticky; top: 0; z-index: 10; }
.tab { flex: 1; text-align: center; padding: 24rpx 0; font-size: 26rpx; color: #666; }
.tab.active { color: var(--c-primary-dark); font-weight: bold; }

.list { padding: 20rpx 24rpx; }
.order-card { background: #fff; border-radius: 16rpx; margin-bottom: 20rpx; padding: 24rpx; }
.o-head { margin-bottom: 16rpx; }
.o-no { font-size: 22rpx; color: #999; }
.o-status { font-size: 26rpx; font-weight: bold; }
.o-status.pending { color: var(--c-gold); }
.o-status.paid { color: #2b7fff; }
.o-status.shipped { color: var(--c-primary); }
.o-status.completed { color: #999; }
.o-status.cancelled { color: #bbb; }
.o-goods { border-top: 1rpx solid #f5f5f5; padding-top: 16rpx; }
.g-item { display: flex; align-items: center; margin-bottom: 12rpx; }
.g-cover { width: 100rpx; height: 100rpx; border-radius: 10rpx; overflow: hidden; margin-right: 16rpx; }
.g-name { font-size: 26rpx; }
.g-price { font-size: 24rpx; color: #999; display: block; margin-top: 6rpx; }
.o-foot { margin-top: 16rpx; border-top: 1rpx solid #f5f5f5; padding-top: 16rpx; }
.o-total { font-size: 26rpx; }
.o-actions { display: flex; gap: 16rpx; }
.o-btn { padding: 10rpx 24rpx; background: var(--c-primary-dark); color: #fff; border-radius: 30rpx; font-size: 24rpx; }
.o-btn.outline { background: #fff; border: 1rpx solid var(--c-primary-dark); color: var(--c-primary-dark); }
