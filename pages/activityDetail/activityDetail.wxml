<view class="page" wx:if="{{item}}">
  <view class="cover"><cover text="{{item.title}}" seed="{{item.id}}" src="{{item.cover}}"></cover></view>

  <view class="section card">
    <view class="title">{{item.title}}</view>
    <view class="info-list">
      <view class="info-item"><text class="lbl">时间</text><text>{{item.startTime}} 至 {{item.endTime}}</text></view>
      <view class="info-item"><text class="lbl">地点</text><text>{{item.address}}</text></view>
      <view class="info-item"><text class="lbl">名额</text><text>{{item.joined}}/{{item.maxPeople}} 人</text></view>
      <view class="info-item"><text class="lbl">主办</text><text>{{inheritor?inheritor.name:'-'}}</text></view>
    </view>
  </view>

  <view class="section card">
    <view class="section-title" style="margin-top:0">活动介绍</view>
    <view class="intro">{{item.intro}}</view>
  </view>

  <!-- 已报名信息 -->
  <view class="section card" wx:if="{{myReg}}">
    <view class="section-title" style="margin-top:0">我的报名</view>
    <view class="reg-status">
      <text class="tag tag-green">已报名</text>
      <text wx:if="{{myReg.status==='signed'}}" class="tag tag-blue">已签到</text>
    </view>
    <view class="signin-box" wx:if="{{myReg.status!=='signed'}}">
      <text class="signin-label">签到码</text>
      <text class="signin-code">{{myReg.signinCode}}</text>
      <text class="signin-tip">请在活动现场出示此签到码</text>
      <view class="btn-outline mt-20" bindtap="goSignin">我要签到</view>
    </view>
    <view wx:if="{{myReg.rating}}">
      <view class="rating">我的评价：{{myReg.rating}} 星</view>
      <view class="comment">「{{myReg.comment}}」</view>
    </view>
    <view wx:else>
      <view class="btn-primary mt-20" bindtap="showRating">活动评价</view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view wx:if="{{!myReg}}" class="btn-primary flex1" bindtap="doRegister">立即报名</view>
    <view wx:else class="btn-outline flex1" bindtap="doCancel">取消报名</view>
  </view>

  <!-- 评价弹窗 -->
  <view class="mask" wx:if="{{showRatingModal}}" bindtap="closeRating">
    <view class="modal" catchtap="">
      <view class="modal-title">活动评价</view>
      <view class="stars">
        <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="star {{rating>=item?'on':''}}" bindtap="setRating" data-v="{{item}}">★</text>
      </view>
      <textarea class="comment-input" placeholder="说说你的感受..." value="{{comment}}" bindinput="onComment" maxlength="200"/>
      <view class="row" style="gap:20rpx">
        <view class="btn-outline flex1" bindtap="closeRating">取消</view>
        <view class="btn-primary flex1" bindtap="submitRating">提交</view>
      </view>
    </view>
  </view>
</view>
